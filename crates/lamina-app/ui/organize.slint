// O modo organizar a lâmina (spec EG): o título da lâmina em destaque, os quadros selecionados, o
// laço e o painel do modo. Só desenho: o editor decide e o Rust preenche o `OrganizeUi`.

import { Button, CheckBox, LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { BoxData } from "canvas.slint";
import { LookPanel } from "look.slint";

// Uma marca do ímã de mesmo tamanho ou de espaçamento igual: a linha e o texto, em frações da
// largura da lâmina.
export struct MarkData {
    line: BoxData,
    text: string,
    tx: float,
    ty: float,
}

export global OrganizeUi {
    in property <bool> on;
    // "Organizando a lâmina 3 · Esc conclui".
    in property <string> title;
    // "2 quadros" (vazio sem seleção).
    in property <string> count;
    // Os quadros selecionados e a caixa do grupo, em frações da largura da lâmina.
    in property <[BoxData]> boxes;
    in property <BoxData> group;
    in property <bool> has-group;
    // As marcas do ímã durante o gesto ("= 9 cm" e os vãos iguais).
    in property <[MarkData]> marks;
    // O laço em andamento, em pixels da janela.
    in-out property <bool> lassoing;
    in-out property <length> lasso-x0;
    in-out property <length> lasso-y0;
    in-out property <length> lasso-x1;
    in-out property <length> lasso-y1;
    // Os campos da seleção (X e Y a partir do corte, largura e altura da caixa do grupo).
    in property <string> unit;
    in-out property <string> gx;
    in-out property <string> gy;
    in-out property <string> gw;
    in-out property <string> gh;
    in-out property <bool> keep: true;
    in property <string> field-error;
    // "Selecione três quadros ou mais." enquanto Distribuir não vale.
    in property <string> hint;
    callback done();
    // 0 = X, 1 = Y, 2 = largura, 3 = altura.
    callback field-accepted(int);
    // Um comando do registro pelo nome estável (Alinhar, Igualar, Distribuir).
    callback command(string);
}

// Um botão pequeno que roda um comando do registro.
component Act inherits Button {
    in property <string> name;
    horizontal-stretch: 1;
    clicked => { OrganizeUi.command(root.name); }
}

// A barra da lâmina em destaque, em cima da área da lâmina.
export component OrganizeBar inherits Rectangle {
    height: 34px;
    background: #1f3b57;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 12px;
        Text {
            text: OrganizeUi.title;
            color: white;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Button {
            text: "Concluir";
            clicked => { OrganizeUi.done(); }
        }
    }
}

// Os quadros selecionados por cima da lâmina (`unit` = a largura dela em pixels).
export component OrganizeMarks inherits Rectangle {
    in property <length> unit;
    for b in OrganizeUi.boxes: Rectangle {
        x: b.x * root.unit;
        y: b.y * root.unit;
        width: b.w * root.unit;
        height: b.h * root.unit;
        border-width: 3px;
        border-color: #4fc3f7;
    }
    if OrganizeUi.has-group: Rectangle {
        x: OrganizeUi.group.x * root.unit - 3px;
        y: OrganizeUi.group.y * root.unit - 3px;
        width: OrganizeUi.group.w * root.unit + 6px;
        height: OrganizeUi.group.h * root.unit + 6px;
        border-width: 1px;
        border-color: #ffffffb0;
    }
    for m in OrganizeUi.marks: Rectangle {
        Rectangle {
            x: m.line.x * root.unit;
            y: m.line.y * root.unit;
            width: max(1px, m.line.w * root.unit);
            height: max(1px, m.line.h * root.unit);
            background: #ff4fd8;
        }
        Rectangle {
            x: m.tx * root.unit;
            y: m.ty * root.unit - self.height / 2;
            width: label.preferred-width + 8px;
            height: label.preferred-height + 4px;
            background: #000000b0;
            border-radius: 3px;
            label := Text {
                x: 4px;
                y: 2px;
                text: m.text;
                color: #ff4fd8;
                font-size: 11px;
            }
        }
    }
}

// O laço, em pixels da janela.
export component LassoBox inherits Rectangle {
    x: min(OrganizeUi.lasso-x0, OrganizeUi.lasso-x1);
    y: min(OrganizeUi.lasso-y0, OrganizeUi.lasso-y1);
    width: abs(OrganizeUi.lasso-x1 - OrganizeUi.lasso-x0);
    height: abs(OrganizeUi.lasso-y1 - OrganizeUi.lasso-y0);
    background: #4fc3f722;
    border-width: 1px;
    border-color: #4fc3f7;
}

// O painel da direita no modo (EG-B23): a seleção, fundo e espaço da lâmina.
export component OrganizePanel inherits VerticalLayout {
    callback done();
    spacing: 8px;
    Text { text: "Organizar"; color: Theme.text; font-weight: 700; }
    Text {
        text: OrganizeUi.count == "" ? "Clique num quadro; Ctrl+clique soma; arraste no vazio para o laço." : OrganizeUi.count;
        color: Theme.muted;
        wrap: word-wrap;
    }
    if OrganizeUi.count != "": Text {
        text: "Posição e tamanho (" + OrganizeUi.unit + ", a partir do corte)";
        color: Theme.text;
    }
    if OrganizeUi.count != "": GridLayout {
        spacing: 6px;
        Row {
            Text { text: "X"; color: Theme.text; vertical-alignment: center; }
            LineEdit { width: 84px; text <=> OrganizeUi.gx; accepted => { OrganizeUi.field-accepted(0); } }
            Text { text: "Y"; color: Theme.text; vertical-alignment: center; }
            LineEdit { width: 84px; text <=> OrganizeUi.gy; accepted => { OrganizeUi.field-accepted(1); } }
        }
        Row {
            Text { text: "Larg."; color: Theme.text; vertical-alignment: center; }
            LineEdit { width: 84px; text <=> OrganizeUi.gw; accepted => { OrganizeUi.field-accepted(2); } }
            Text { text: "Alt."; color: Theme.text; vertical-alignment: center; }
            LineEdit { width: 84px; text <=> OrganizeUi.gh; accepted => { OrganizeUi.field-accepted(3); } }
        }
    }
    if OrganizeUi.count != "": CheckBox { text: "Manter proporção"; checked <=> OrganizeUi.keep; }
    if OrganizeUi.field-error != "": Text { text: OrganizeUi.field-error; color: #e57373; wrap: word-wrap; }
    if OrganizeUi.count != "": Text { text: "Alinhar"; color: Theme.text; font-weight: 700; }
    if OrganizeUi.count != "": HorizontalLayout {
        spacing: 4px;
        Act { text: "Esquerda"; name: "organizar.alinhar-esquerda"; }
        Act { text: "Centro"; name: "organizar.alinhar-centro"; }
        Act { text: "Direita"; name: "organizar.alinhar-direita"; }
    }
    if OrganizeUi.count != "": HorizontalLayout {
        spacing: 4px;
        Act { text: "Topo"; name: "organizar.alinhar-topo"; }
        Act { text: "Meio"; name: "organizar.alinhar-meio"; }
        Act { text: "Base"; name: "organizar.alinhar-base"; }
    }
    if OrganizeUi.count != "": Text { text: "Igualar"; color: Theme.text; font-weight: 700; }
    if OrganizeUi.count != "": HorizontalLayout {
        spacing: 4px;
        Act { text: "Largura"; name: "organizar.igualar-largura"; }
        Act { text: "Altura"; name: "organizar.igualar-altura"; }
        Act { text: "Tamanho"; name: "organizar.igualar-tamanho"; }
    }
    if OrganizeUi.count != "": Text { text: "Distribuir"; color: Theme.text; font-weight: 700; }
    if OrganizeUi.count != "": HorizontalLayout {
        spacing: 4px;
        Act { text: "Na horizontal"; name: "organizar.distribuir-horizontal"; }
        Act { text: "Na vertical"; name: "organizar.distribuir-vertical"; }
    }
    if OrganizeUi.hint != "" && OrganizeUi.count != "": Text { text: OrganizeUi.hint; color: Theme.muted; wrap: word-wrap; }
    LookPanel {
        vertical-stretch: 1;
        done => { root.done(); }
    }
}

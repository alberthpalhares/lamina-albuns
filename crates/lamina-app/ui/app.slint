// Janela principal do Lâmina (spec `janela-principal`). Só desenho: os dados e as decisões vêm
// do lamina-editor, pelo Rust (src/).

import { Button, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { SpreadCanvas, SpreadData, FrameData, BoxData } from "canvas.slint";
import { NewAlbumDialog, ConfirmDialog, MessageDialog, BusyOverlay } from "dialogs.slint";
import { LayoutsPanel, LayoutItem } from "layouts.slint";

export { SpreadData, FrameData, BoxData, LayoutItem }

export struct PhotoData {
    img: image,
    name: string,
    uses: int,
    selected: bool,
}

// Uma posição da timeline: uma foto, ou o corte depois da lâmina `spread`.
export struct TimelineItem {
    img: image,
    cut: bool,
    spread: int,
}

component BarButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    width: label.preferred-width + 24px;
    border-radius: 4px;
    background: touch.has-hover && root.enabled ? #ffffff1a : transparent;
    label := Text {
        text: root.text;
        color: root.enabled ? Theme.text : #6b6b6b;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component FilterTab inherits BarButton {
    in property <bool> active;
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: root.active ? Theme.selected : transparent;
    }
}

export component AppWindow inherits Window {
    title: root.window-title;
    min-width: 800px;
    min-height: 600px;
    preferred-width: 1400px;
    preferred-height: 900px;
    background: Theme.background;
    forward-focus: keys;

    in property <string> window-title: "Lâmina";
    in property <string> project-title;
    in property <string> counter;
    in property <bool> has-project;
    in property <bool> can-save;
    in property <bool> can-prev;
    in property <bool> can-next;
    in property <bool> guides: true;
    in property <SpreadData> current;
    in property <int> current-index;
    in property <[SpreadData]> spreads;
    in property <[PhotoData]> photos;
    in property <int> filter;
    in property <int> selected-photo: -1;
    in property <string> info-album;
    in property <string> info-spread;
    in property <string> info-warnings;
    in property <string> info-photo;
    in property <string> notice;
    in property <string> version;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> can-layout;
    in property <bool> can-left;
    in property <bool> can-right;
    in property <bool> can-mirror;
    in property <bool> can-mark;

    // Painel de layouts (spec TL).
    in-out property <int> panel-tab;
    in property <[LayoutItem]> layouts;
    in property <int> layout-in-use: -1;
    in property <int> layout-list;
    in property <bool> has-reordered;
    in property <string> layout-count;
    in property <string> layout-notice;
    in property <string> layout-explanation;

    in-out property <bool> show-new;
    in-out property <bool> show-confirm;
    in-out property <bool> show-message;
    in-out property <bool> show-about;
    in property <string> message-title;
    in property <string> message-text;
    in property <string> busy-text;

    // Campos da janela "Novo álbum".
    in property <string> na-folder;
    in-out property <string> na-name;
    in-out property <string> na-width;
    in-out property <string> na-height;
    in-out property <string> na-dpi;
    in-out property <string> na-bleed;
    in-out property <string> na-safe;
    in-out property <string> na-spine;
    in-out property <bool> na-starts;
    in-out property <bool> na-ends;
    in-out property <int> na-spreads;
    in-out property <int> na-reuse;
    in property <int> na-photos;
    in property <string> na-suggestion;
    in property <string> na-error;

    callback command(string);
    callback key(string, bool, bool) -> bool;
    callback go-to(int);
    callback photo-clicked(int);
    callback photo-double-clicked(int);
    callback filter-changed(int);
    callback na-changed();
    callback na-create();
    callback confirm(int);
    // Arrastar (spec FQ): 0 nada, 1 foto do navegador, 2 quadro, 3 lâmina na faixa.
    in-out property <int> drag-kind;
    in-out property <int> drag-from: -1;
    in-out property <image> drag-img;
    in-out property <length> drag-x;
    in-out property <length> drag-y;
    in-out property <length> press-x;
    in-out property <length> press-y;
    in property <int> selected-frame: -1;
    in property <[TimelineItem]> timeline;
    // Recorte (spec RC).
    in property <int> crop-frame: -1;
    in property <bool> has-preview;
    in property <BoxData> preview;
    in property <image> preview-img;
    in property <string> info-frame;
    in property <bool> info-frame-warn;
    callback frame-double(int);
    callback crop-drag(float, float);
    callback crop-end();
    callback crop-wheel(int);
    callback photo-pressed(int, bool, bool);
    callback drop-photo(int, float, float);
    callback drop-frame(int, float, float);
    callback frame-selected(int);
    callback move-spread(int, int);
    callback cut-moved(int, int);
    callback layout-apply(int);
    callback layout-favorite(int);
    callback layout-reject(int);
    callback layout-list-changed(int);

    public function focus-main() {
        keys.focus();
    }

    // Começa a arrastar só depois de 6 px, para um clique não virar arrasto.
    function far(x: length, y: length) -> bool {
        abs(x - root.press-x) > 6px || abs(y - root.press-y) > 6px
    }

    // Onde o ponteiro está na lâmina grande, em frações da largura dela.
    function frac-x() -> float { (root.drag-x - big.absolute-position.x) / big.width }
    function frac-y() -> float { (root.drag-y - big.absolute-position.y) / big.width }

    // A lâmina atual fica visível na faixa (spec JP, regra 7): se saiu da área vista, a faixa
    // rola até deixá-la no meio.
    changed current-index => {
        if (root.current.aspect <= 0) {
            return;
        }
        let item = 84px / root.current.aspect + 6px + 10px;
        let left = 10px + root.current-index * item;
        let shown = strip-scroll.visible-width;
        if (left + strip-scroll.content-x < 0px || left + item + strip-scroll.content-x > shown) {
            strip-scroll.content-x = max(min(0px, shown / 2 - left - item / 2), shown - strip.preferred-width);
        }
    }

    MenuBar {
        Menu {
            title: "Arquivo";
            MenuItem { title: "Novo álbum…  (Ctrl+N)"; activated => { root.command("arquivo.novo"); } }
            MenuItem { title: "Abrir…  (Ctrl+O)"; activated => { root.command("arquivo.abrir"); } }
            MenuSeparator { }
            MenuItem { title: "Salvar  (Ctrl+S)"; enabled: root.can-save; activated => { root.command("arquivo.salvar"); } }
            MenuItem { title: "Salvar como…  (Ctrl+Shift+S)"; enabled: root.can-save; activated => { root.command("arquivo.salvar-como"); } }
        }
        Menu {
            title: "Editar";
            MenuItem { title: "Desfazer  (Ctrl+Z)"; enabled: root.can-undo; activated => { root.command("editar.desfazer"); } }
            MenuItem { title: "Refazer  (Ctrl+Y)"; enabled: root.can-redo; activated => { root.command("editar.refazer"); } }
        }
        Menu {
            title: "Lâmina";
            MenuItem { title: "Próxima lâmina  (Page Down)"; enabled: root.can-next; activated => { root.command("lamina.proxima"); } }
            MenuItem { title: "Lâmina anterior  (Page Up)"; enabled: root.can-prev; activated => { root.command("lamina.anterior"); } }
            MenuItem { title: "Primeira lâmina  (Home)"; enabled: root.can-prev; activated => { root.command("lamina.primeira"); } }
            MenuItem { title: "Última lâmina  (End)"; enabled: root.can-next; activated => { root.command("lamina.ultima"); } }
        }
        Menu {
            title: "Layout";
            MenuItem { title: "Próximo layout  (→)"; enabled: root.can-layout; activated => { root.command("layout.proximo"); } }
            MenuItem { title: "Layout anterior  (←)"; enabled: root.can-layout; activated => { root.command("layout.anterior"); } }
            MenuItem { title: "Próximo da página esquerda  (↓)"; enabled: root.can-left; activated => { root.command("layout.esquerda-proximo"); } }
            MenuItem { title: "Anterior da página esquerda  (↑)"; enabled: root.can-left; activated => { root.command("layout.esquerda-anterior"); } }
            MenuItem { title: "Próximo da página direita  (Shift+↓)"; enabled: root.can-right; activated => { root.command("layout.direita-proximo"); } }
            MenuItem { title: "Anterior da página direita  (Shift+↑)"; enabled: root.can-right; activated => { root.command("layout.direita-anterior"); } }
            MenuSeparator { }
            MenuItem { title: "Espelhar lâmina  (E)"; enabled: root.can-mirror; activated => { root.command("layout.espelhar"); } }
            MenuItem { title: "Favoritar layout  (F)"; enabled: root.can-mark; activated => { root.command("layout.favoritar"); } }
            MenuItem { title: "Rejeitar layout  (X)"; enabled: root.can-mark; activated => { root.command("layout.rejeitar"); } }
            MenuItem { title: root.layout-list == 1 ? "Mostrar na ordem  (R)" : "Mostrar reordenadas  (R)"; enabled: root.has-project; activated => { root.command("layout.reordenadas"); } }
        }
        Menu {
            title: "Visualizar";
            MenuItem { title: root.guides ? "Esconder guias  (G)" : "Mostrar guias  (G)"; enabled: root.has-project; activated => { root.command("ver.guias"); } }
        }
        Menu {
            title: "Ajuda";
            MenuItem { title: "Sobre o Lâmina"; activated => { root.command("ajuda.sobre"); } }
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (root.show-new || root.show-confirm || root.show-message || root.show-about || root.busy-text != "") {
                return reject;
            }
            if (event.text == Key.PageDown) { return root.key("PageDown", event.modifiers.control, event.modifiers.shift) ? accept : reject; }
            if (event.text == Key.PageUp) { return root.key("PageUp", event.modifiers.control, event.modifiers.shift) ? accept : reject; }
            if (event.text == Key.Home) { return root.key("Home", event.modifiers.control, event.modifiers.shift) ? accept : reject; }
            if (event.text == Key.End) { return root.key("End", event.modifiers.control, event.modifiers.shift) ? accept : reject; }
            if (event.text == Key.LeftArrow) { return root.key("Left", event.modifiers.control, event.modifiers.shift) ? accept : reject; }
            if (event.text == Key.RightArrow) { return root.key("Right", event.modifiers.control, event.modifiers.shift) ? accept : reject; }
            if (event.text == Key.Delete) { return root.key("Delete", event.modifiers.control, event.modifiers.shift) ? accept : reject; }
            if (event.text == Key.Backspace) { return root.key("Backspace", event.modifiers.control, event.modifiers.shift) ? accept : reject; }
            if (event.text == Key.Escape) { return root.key("Escape", event.modifiers.control, event.modifiers.shift) ? accept : reject; }
            if (event.text == Key.Return) { return root.key("Enter", event.modifiers.control, event.modifiers.shift) ? accept : reject; }
            if (event.text == Key.UpArrow) { return root.key("Up", event.modifiers.control, event.modifiers.shift) ? accept : reject; }
            if (event.text == Key.DownArrow) { return root.key("Down", event.modifiers.control, event.modifiers.shift) ? accept : reject; }
            root.key(event.text, event.modifiers.control, event.modifiers.shift) ? accept : reject
        }

        VerticalLayout {
            // Barra do projeto.
            Rectangle {
                height: 44px;
                background: Theme.bar;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 8px;
                    spacing: 16px;
                    Text {
                        text: root.project-title;
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Text { text: root.counter; color: Theme.muted; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    BarButton { text: "Novo"; clicked => { root.command("arquivo.novo"); } }
                    BarButton { text: "Abrir"; clicked => { root.command("arquivo.abrir"); } }
                    BarButton { text: "Salvar"; enabled: root.can-save; clicked => { root.command("arquivo.salvar"); } }
                    BarButton { text: "Exportar"; enabled: false; }
                }
            }

            if root.notice != "": Rectangle {
                height: 30px;
                background: #4a3f1f;
                Text { x: 16px; text: root.notice; color: Theme.text; vertical-alignment: center; }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                // Lâmina atual.
                area := Rectangle {
                    horizontal-stretch: 1;
                    property <length> canvas-width: root.current.aspect > 0
                        ? min(self.width - 48px, (self.height - 48px) / root.current.aspect) : 0px;
                    // Clique fora dos quadros: desmarca e sai do modo recorte.
                    TouchArea { clicked => { root.frame-selected(-1); root.focus-main(); } }
                    // Sempre na árvore (some sem projeto) para o arrastar achar a posição dela.
                    big := SpreadCanvas {
                        cropping: root.crop-frame;
                        has-preview: root.has-preview;
                        preview: root.preview;
                        preview-img: root.preview-img;
                        frame-double(i) => { root.frame-double(i); root.focus-main(); }
                        crop-drag(dx, dy) => { root.crop-drag(dx, dy); }
                        crop-end() => { root.crop-end(); root.focus-main(); }
                        crop-wheel(n) => { root.crop-wheel(n); }
                        visible: root.has-project;
                        width: area.canvas-width;
                        height: area.canvas-width * root.current.aspect;
                        data: root.current;
                        guides: root.guides;
                        interactive: true;
                        selected: root.selected-frame;
                        drop-shadow-blur: 16px;
                        drop-shadow-color: #00000080;
                        frame-down(i, x, y) => {
                            root.press-x = x;
                            root.press-y = y;
                            root.drag-from = i;
                        }
                        frame-move(i, x, y) => {
                            if (root.drag-kind == 0 && root.far(x, y)) {
                                root.drag-kind = 2;
                                root.drag-img = root.current.frames[i].img;
                            }
                            root.drag-x = x;
                            root.drag-y = y;
                        }
                        frame-up(i, x, y) => {
                            if (root.drag-kind == 2) {
                                root.drop-frame(root.drag-from, root.frac-x(), root.frac-y());
                            } else {
                                root.frame-selected(i);
                            }
                            root.drag-kind = 0;
                            root.focus-main();
                        }
                    }
                    if !root.has-project: VerticalLayout {
                        alignment: center;
                        spacing: 16px;
                        Text { text: "Lâmina"; font-size: 40px; font-weight: 700; color: Theme.text; horizontal-alignment: center; }
                        Text { text: "Diagramação de álbuns de fotos"; color: Theme.muted; horizontal-alignment: center; }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 12px;
                            Button { text: "Novo álbum a partir de uma pasta…"; primary: true; clicked => { root.command("arquivo.novo"); } }
                            Button { text: "Abrir projeto…"; clicked => { root.command("arquivo.abrir"); } }
                        }
                    }
                }

                // Painel da direita: layouts (padrão) e informações.
                if root.has-project: Rectangle {
                    width: 300px;
                    background: Theme.panel;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 16px;
                            Rectangle {
                                height: 30px;
                                width: layouts-tab.preferred-width;
                                layouts-tab := Text {
                                    text: "Layouts";
                                    color: root.panel-tab == 0 ? Theme.selected : Theme.muted;
                                    font-weight: root.panel-tab == 0 ? 700 : 400;
                                }
                                TouchArea { clicked => { root.panel-tab = 0; } }
                            }
                            Rectangle {
                                height: 30px;
                                width: info-tab.preferred-width;
                                info-tab := Text {
                                    text: "Informações";
                                    color: root.panel-tab == 1 ? Theme.selected : Theme.muted;
                                    font-weight: root.panel-tab == 1 ? 700 : 400;
                                }
                                TouchArea { clicked => { root.panel-tab = 1; } }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if root.panel-tab == 0: LayoutsPanel {
                            vertical-stretch: 1;
                            items: root.layouts;
                            in-use: root.layout-in-use;
                            list: root.layout-list;
                            has-reordered: root.has-reordered;
                            count: root.layout-count;
                            notice: root.layout-notice;
                            explanation: root.layout-explanation;
                            aspect: root.current.aspect;
                            apply(i) => { root.layout-apply(i); root.focus-main(); }
                            favorite(i) => { root.layout-favorite(i); root.focus-main(); }
                            reject(i) => { root.layout-reject(i); root.focus-main(); }
                            list-changed(i) => { root.layout-list-changed(i); root.focus-main(); }
                        }
                        if root.panel-tab == 1: VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 8px;
                            Text { text: "Álbum"; color: Theme.muted; font-size: 12px; }
                            Text { text: root.info-album; color: Theme.text; wrap: word-wrap; }
                            Text { text: "Lâmina"; color: Theme.muted; font-size: 12px; }
                            Text { text: root.info-spread; color: Theme.text; wrap: word-wrap; }
                            Text { text: root.info-warnings; color: Theme.warning; wrap: word-wrap; }
                            if root.info-frame != "": Text { text: "Quadro"; color: Theme.muted; font-size: 12px; }
                            Text { text: root.info-frame; color: root.info-frame-warn ? Theme.warning : Theme.text; wrap: word-wrap; }
                            if root.info-photo != "": Text { text: "Foto"; color: Theme.muted; font-size: 12px; }
                            Text { text: root.info-photo; color: Theme.text; wrap: word-wrap; }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                }
            }

            // Faixa de lâminas: a atual com contorno claro e o número embaixo de cada uma.
            // Fica sempre na árvore (só some sem projeto) para o `changed current-index` rolar.
            Rectangle {
                visible: root.has-project;
                height: root.has-project ? 128px : 0px;
                background: Theme.bar;
                strip-scroll := ScrollView {
                    content-width: strip.preferred-width;
                    content-height: self.height;
                    strip := HorizontalLayout {
                        padding: 8px;
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        for s[i] in root.spreads: VerticalLayout {
                            spacing: 4px;
                            Rectangle {
                                width: 84px / s.aspect + 6px;
                                height: 90px;
                                border-radius: 4px;
                                border-width: 2px;
                                border-color: i == root.current-index ? Theme.selected : transparent;
                                SpreadCanvas {
                                    x: 3px;
                                    y: 3px;
                                    width: parent.width - 6px;
                                    height: parent.height - 6px;
                                    data: s;
                                    small: true;
                                }
                                if s.warning: Rectangle {
                                    x: parent.width - 21px;
                                    y: 6px;
                                    width: 14px;
                                    height: 14px;
                                    border-radius: 7px;
                                    background: Theme.warning;
                                    Text { text: "!"; color: black; font-size: 10px; font-weight: 700; }
                                }
                                TouchArea {
                                    moved => {
                                        let x = self.absolute-position.x + self.mouse-x;
                                        let y = self.absolute-position.y + self.mouse-y;
                                        if (root.drag-kind == 0 && root.far(x, y)) {
                                            root.drag-kind = 3;
                                            root.drag-from = i;
                                        }
                                        root.drag-x = x;
                                        root.drag-y = y;
                                    }
                                    pointer-event(e) => {
                                        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                            root.press-x = self.absolute-position.x + self.mouse-x;
                                            root.press-y = self.absolute-position.y + self.mouse-y;
                                        }
                                        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                                            if (root.drag-kind == 3) {
                                                let item = 84px / s.aspect + 16px;
                                                let at = (root.drag-x - strip-scroll.absolute-position.x - strip-scroll.content-x - 10px) / item;
                                                root.move-spread(i, max(0, min(root.spreads.length - 1, floor(at))));
                                            } else {
                                                root.go-to(i);
                                            }
                                            root.drag-kind = 0;
                                            root.focus-main();
                                        }
                                    }
                                }
                            }
                            Text {
                                text: i + 1;
                                horizontal-alignment: center;
                                color: i == root.current-index ? Theme.selected : Theme.muted;
                                font-size: 12px;
                                font-weight: i == root.current-index ? 700 : 400;
                            }
                        }
                    }
                }
            }

            // Timeline (spec FQ, regra 8): as fotos na ordem do álbum e um corte entre as lâminas.
            if root.has-project: Rectangle {
                height: 58px;
                background: Theme.background;
                ScrollView {
                    content-width: line.preferred-width;
                    content-height: self.height;
                    line := HorizontalLayout {
                        padding: 6px;
                        spacing: 2px;
                        for t in root.timeline: Rectangle {
                            width: t.cut ? 14px : 46px;
                            if !t.cut: Image {
                                width: 44px;
                                height: 44px;
                                source: t.img;
                                image-fit: contain;
                            }
                            if t.cut: Rectangle {
                                cut-touch := TouchArea {
                                    mouse-cursor: ew-resize;
                                    pointer-event(e) => {
                                        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                            root.press-x = self.absolute-position.x + self.mouse-x;
                                        }
                                        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                                            let dx = self.absolute-position.x + self.mouse-x - root.press-x;
                                            root.cut-moved(t.spread, round(dx / 48px));
                                            root.focus-main();
                                        }
                                    }
                                }
                                Rectangle {
                                    x: 5px;
                                    width: 4px;
                                    border-radius: 2px;
                                    background: cut-touch.has-hover || cut-touch.pressed ? Theme.selected : Theme.muted;
                                }
                            }
                        }
                    }
                }
            }

            // Navegador de fotos.
            if root.has-project: Rectangle {
                height: 176px;
                background: Theme.panel;
                VerticalLayout {
                    HorizontalLayout {
                        height: 32px;
                        padding-left: 8px;
                        FilterTab { text: "Todas"; active: root.filter == 0; clicked => { root.filter-changed(0); } }
                        FilterTab { text: "Usadas"; active: root.filter == 1; clicked => { root.filter-changed(1); } }
                        FilterTab { text: "Não usadas"; active: root.filter == 2; clicked => { root.filter-changed(2); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    ScrollView {
                        content-width: browser.preferred-width;
                        content-height: self.height;
                        browser := HorizontalLayout {
                            padding: 8px;
                            spacing: 8px;
                            for p[i] in root.photos: Rectangle {
                                width: 140px;
                                height: 120px;
                                background: p.selected ? #4fc3f740 : i == root.selected-photo ? #ffffff1f : transparent;
                                border-radius: 4px;
                                Image {
                                    y: 4px;
                                    width: parent.width - 8px;
                                    height: 92px;
                                    source: p.img;
                                    image-fit: contain;
                                }
                                Text {
                                    x: 6px;
                                    y: parent.height - 20px;
                                    width: parent.width - 36px;
                                    text: p.name;
                                    color: Theme.muted;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                                Text {
                                    x: parent.width - 26px;
                                    y: parent.height - 20px;
                                    text: p.uses == 0 ? "–" : "×" + p.uses;
                                    color: p.uses == 0 ? Theme.muted : Theme.text;
                                    font-size: 11px;
                                }
                                TouchArea {
                                    double-clicked => { root.photo-double-clicked(i); }
                                    moved => {
                                        let x = self.absolute-position.x + self.mouse-x;
                                        let y = self.absolute-position.y + self.mouse-y;
                                        if (root.drag-kind == 0 && root.far(x, y)) {
                                            root.drag-kind = 1;
                                            root.drag-from = i;
                                            root.drag-img = p.img;
                                        }
                                        root.drag-x = x;
                                        root.drag-y = y;
                                    }
                                    pointer-event(e) => {
                                        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                            root.press-x = self.absolute-position.x + self.mouse-x;
                                            root.press-y = self.absolute-position.y + self.mouse-y;
                                        }
                                        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                                            if (root.drag-kind == 1) {
                                                root.drop-photo(root.drag-from, root.frac-x(), root.frac-y());
                                            } else {
                                                root.photo-pressed(i, e.modifiers.control, e.modifiers.shift);
                                            }
                                            root.drag-kind = 0;
                                            root.focus-main();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.show-new: NewAlbumDialog {
        folder: root.na-folder;
        name <=> root.na-name;
        width-cm <=> root.na-width;
        height-cm <=> root.na-height;
        dpi <=> root.na-dpi;
        bleed-mm <=> root.na-bleed;
        safe-mm <=> root.na-safe;
        spine-mm <=> root.na-spine;
        starts-single <=> root.na-starts;
        ends-single <=> root.na-ends;
        spreads <=> root.na-spreads;
        reuse <=> root.na-reuse;
        photos: root.na-photos;
        suggestion: root.na-suggestion;
        error: root.na-error;
        changed => { root.na-changed(); }
        create => { root.na-create(); }
        cancel => {
            root.show-new = false;
            root.focus-main();
        }
    }
    if root.show-confirm: ConfirmDialog {
        name: root.project-title;
        answer(choice) => { root.confirm(choice); }
    }
    if root.show-message: MessageDialog {
        title: root.message-title;
        message: root.message-text;
        close => {
            root.show-message = false;
            root.focus-main();
        }
    }
    if root.show-about: MessageDialog {
        title: "Sobre o Lâmina";
        message: "Lâmina " + root.version + "\nDiagramação de álbuns de fotos, em Rust.\nLicença Apache-2.0.\n\nFeito com Slint (slint.dev).";
        close => {
            root.show-about = false;
            root.focus-main();
        }
    }
    if root.drag-kind == 1 || root.drag-kind == 2: Image {
        x: root.drag-x - 40px;
        y: root.drag-y - 40px;
        width: 80px;
        height: 80px;
        source: root.drag-img;
        image-fit: contain;
        opacity: 0.8;
    }
    if root.busy-text != "": BusyOverlay {
        text: root.busy-text;
    }
}

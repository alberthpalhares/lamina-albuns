// Janela principal do Lamina (spec `janela-principal`). Só desenho: os dados e as decisões vêm
// do lamina-editor, pelo Rust (src/).

import { Button, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { SpreadCanvas, SpreadData, FrameData, BoxData } from "canvas.slint";
import { ConfirmDialog, MessageDialog, BusyOverlay } from "dialogs.slint";
import { NewProjectDialog, NewProjectUi, FormatCard, DrawData } from "new_project.slint";
import { ImportUi, DropOverlay, EmptyAlbum } from "importing.slint";
import { LayoutItem } from "layouts.slint";
import { LookUi, Swatch } from "look.slint";
import { FrameUi } from "frame.slint";
import { AboutDialog } from "about.slint";
import { ModelNameDialog, ModelsDialog, ModelUi } from "models.slint";
import { HistoryItem } from "history.slint";
import { ExportDialog } from "export.slint";
import { PresetNameDialog, PresetsDialog, PresetUi } from "spec.slint";
import { StripHeader, SpreadStrip, TimelineStrip, PhotoStrip, PhotoData, TimelineItem } from "strips.slint";
import { BarButton, FilterTab } from "widgets.slint";
import { UpdateBar } from "update_bar.slint";
import { RightPanel } from "panel.slint";
import { DragGhost, GhostData } from "ghost.slint";
import { OrganizeUi, OrganizeBar, OrganizeMarks, LassoBox } from "organize.slint";
import { Motion } from "motion.slint";
import { WelcomeScreen, ClearRecentsDialog, RecentsUi, RecentCard, RecentItem } from "welcome.slint";

export { SpreadData, FrameData, BoxData, LayoutItem, Swatch, HistoryItem, PhotoData, TimelineItem, PresetUi, LookUi, FrameUi, ModelUi, RecentsUi, RecentCard, RecentItem, Motion, GhostData, OrganizeUi, NewProjectUi, FormatCard, DrawData, ImportUi }

export component AppWindow inherits Window {
    title: root.window-title;
    icon: @image-url("../icons/lamina-256.png");
    min-width: 800px;
    min-height: 600px;
    preferred-width: 1400px;
    preferred-height: 900px;
    background: Theme.background;
    forward-focus: keys;

    in property <string> window-title: "Lamina";
    in property <string> project-title;
    in property <string> counter;
    in property <bool> has-project;
    in property <bool> can-save;
    in property <bool> can-prev;
    in property <bool> can-next;
    in property <bool> guides: true;
    // "Reduzir movimento" ligado (spec MV, regra 14): a marca no menu Visualizar.
    in property <bool> reduce-motion;
    // Ir para outra lâmina (spec MV, seção 4): a lâmina que sai e o relógio do deslize, guardado
    // por um bool para parar sozinho (ADR 0011, decisão 6).
    in property <SpreadData> leaving;
    in property <bool> has-leaving;
    in-out property <bool> nav-running: false;
    property <duration> nav-t0;
    property <int> nav-dir: 1;
    property <float> nav-p: root.nav-running ? min(1, (animation-tick() - root.nav-t0) / max(1ms, Motion.navigate-ms * 1ms)) : 1;
    property <float> nav-e: 1 - pow(1 - root.nav-p, 3);
    callback nav-ended();
    changed nav-p => {
        if (root.nav-running && root.nav-p >= 1) {
            root.nav-running = false;
            root.nav-ended();
        }
    }
    // `dir`: 1 = para a frente (a nova vem da direita), -1 = para trás.
    public function start-nav(dir: int) {
        root.nav-dir = dir;
        root.nav-t0 = animation-tick();
        root.nav-running = true;
    }
    in property <SpreadData> current;
    in property <int> current-index;
    in property <[SpreadData]> spreads;
    in property <[PhotoData]> photos;
    in property <int> filter;
    in property <int> selected-photo: -1;
    in property <string> info-album;
    in property <string> info-spread;
    in property <string> info-warnings;
    in property <string> info-photo;
    in property <string> notice;
    in property <string> version;
    // Atualização automática (spec DS): o texto da barra e as marcas do menu Ajuda.
    in property <string> update-bar;
    in property <bool> auto-updates: true;
    in property <bool> beta-updates;
    callback update-restart();
    callback update-dismiss();
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> can-layout;
    in property <bool> can-left;
    in property <bool> can-right;
    in property <bool> can-mirror;
    in property <bool> can-mark;

    // Painel de layouts (spec TL).
    in-out property <int> panel-tab;
    in property <[LayoutItem]> layouts;
    in property <int> layout-in-use: -1;
    in property <int> layout-list;
    in property <bool> has-reordered;
    in property <string> layout-count;
    in property <string> layout-notice;
    in property <string> layout-explanation;

    in-out property <bool> show-confirm;
    in-out property <bool> show-message;
    in-out property <bool> show-about;
    in property <string> message-title;
    in property <string> message-text;
    in property <string> message-details;
    in property <string> message-folder;
    callback open-folder();
    // Janela Exportar (spec EI).
    in-out property <bool> show-export;
    in property <string> ex-folder;
    in-out property <bool> ex-all: true;
    in-out property <string> ex-range;
    in-out property <bool> ex-pages;
    in-out property <int> ex-quality: 95;
    in-out property <int> ex-format;
    in-out property <bool> ex-marks;
    in-out property <bool> ex-adobe;
    in property <string> ex-error;
    in property <int> ex-step;
    in property <[string]> ex-warnings;
    in property <string> ex-album;
    in property <string> ex-replace-text;
    callback ex-pick-folder();
    callback ex-changed();
    callback ex-export();
    callback ex-go-to(int);
    callback ex-ignore(int);
    callback ex-proceed();
    callback ex-replace();
    callback ex-back();
    in property <bool> has-missing;
    // Fora da faixa de páginas do laboratório (spec PR): ao lado do contador.
    in property <string> counter-warning;
    // Faixas de baixo (spec PN): o resumo de cada uma e se está aberta.
    in property <string> strip-spreads;
    in property <string> strip-timeline;
    in property <string> strip-photos;
    in property <bool> spreads-open: true;
    in property <bool> timeline-open: true;
    in property <bool> photos-open: true;
    in property <string> busy-text;

    // Campos da janela "Novo álbum".

    callback command(string);
    callback key(string, bool, bool, bool) -> bool;
    callback go-to(int);
    callback photo-clicked(int);
    callback photo-double-clicked(int);
    callback filter-changed(int);
    callback confirm(int);
    // Arrastar (spec FQ): 0 nada, 1 foto do navegador, 2 quadro, 3 lâmina na faixa.
    in-out property <int> drag-kind;
    in-out property <int> drag-from: -1;
    in-out property <image> drag-img;
    in-out property <length> drag-x;
    in-out property <length> drag-y;
    in-out property <length> press-x;
    in-out property <length> press-y;
    // Arrastar (spec MV, regra 12): o fantasma vem do editor quando o arrasto começa; o destaque é
    // o quadro onde a soltura cairia; ao soltar num quadro, o fantasma pousa nele.
    in property <GhostData> ghost;
    callback drag-started(int, int);
    pure callback drop-at(float, float) -> BoxData;
    pure callback spread-shift(int, int, int) -> int;
    changed drag-kind => {
        if (root.drag-kind == 1 || root.drag-kind == 2) {
            root.drag-started(root.drag-kind, root.drag-from);
        }
    }
    property <bool> landing;
    property <duration> land-t0;
    property <length> land-x0;
    property <length> land-y0;
    property <length> land-w0;
    property <length> land-h0;
    property <length> land-x1;
    property <length> land-y1;
    property <length> land-w1;
    property <length> land-h1;
    property <float> land-p: root.landing ? min(1, (animation-tick() - root.land-t0) / max(1ms, Motion.land-ms * 1ms)) : 1;
    property <float> land-e: 1 - pow(1 - root.land-p, 3);
    changed land-p => {
        if (root.landing && root.land-p >= 1) {
            root.landing = false;
        }
    }
    // Soltou: se cai num quadro e há movimento, o fantasma pousa nele.
    function land() {
        let t = root.drop-at(root.frac-x(), root.frac-y());
        if (t.w <= 0 || !Motion.on || Motion.land-ms <= 0) {
            return;
        }
        root.land-w0 = root.ghost.w * 1px;
        root.land-h0 = root.ghost.h * 1px;
        root.land-x0 = root.drag-x - root.land-w0 / 2;
        root.land-y0 = root.drag-y - root.land-h0 / 2;
        root.land-x1 = big.absolute-position.x + t.x * big.width;
        root.land-y1 = big.absolute-position.y + t.y * big.width;
        root.land-w1 = t.w * big.width;
        root.land-h1 = t.h * big.width;
        root.land-t0 = animation-tick();
        root.landing = true;
    }
    in property <int> selected-frame: -1;
    in property <[TimelineItem]> timeline;
    // Histórico (spec HI).
    in property <[HistoryItem]> history;
    in property <int> history-pos;
    in property <string> undo-text;
    in property <string> redo-text;
    callback history-go(int);
    // Recorte (spec RC).
    in property <int> crop-frame: -1;
    in property <bool> has-preview;
    in property <BoxData> preview;
    in property <image> preview-img;
    in property <string> info-frame;
    in property <bool> info-frame-warn;
    callback frame-double(int);
    callback crop-drag(float, float);
    callback crop-end();
    callback crop-wheel(float);
    // Quadros à mão (spec TX): alças e arrasto do texto; o mouse na lâmina para o T.
    callback frame-grab(int, int, length, length, length);
    callback frame-drag(length, length, bool, bool);
    callback organize-press(int, bool, bool, length, length, length);
    callback frame-release();
    in-out property <float> hover-fx: -1;
    // Dica embaixo da lâmina: o que dá para fazer com o quadro selecionado.
    in property <string> hint;
    callback photo-pressed(int, bool, bool);
    callback drop-photo(int, float, float);
    // Fotos do navegador soltas num vão da faixa de lâminas: (foto arrastada, vão).
    callback drop-photos-gap(int, int);
    // O ponteiro sobre a área de lâmina nova, para os arquivos soltos do Explorador (spec IM).
    out property <bool> new-spread-hover: spread-strip.new-hover;
    callback drop-frame(int, float, float);
    callback frame-selected(int);
    // Clique num quadro, com Ctrl (ou Cmd) e Shift: no modo organizar, soma ou tira (spec EG).
    callback frame-clicked(int, bool, bool);
    // O laço do modo organizar: os dois cantos em frações da largura da lâmina e o Shift.
    callback lasso-done(float, float, float, float, bool);
    property <bool> lasso-moved;
    function background-event(kind: int, x: length, y: length, shift: bool) {
        if (!OrganizeUi.on) {
            return;
        }
        if (kind == 0) {
            OrganizeUi.lassoing = true;
            root.lasso-moved = false;
            OrganizeUi.lasso-x0 = x;
            OrganizeUi.lasso-y0 = y;
            OrganizeUi.lasso-x1 = x;
            OrganizeUi.lasso-y1 = y;
        } else if (kind == 1 && OrganizeUi.lassoing) {
            OrganizeUi.lasso-x1 = x;
            OrganizeUi.lasso-y1 = y;
            root.lasso-moved = root.lasso-moved || abs(x - OrganizeUi.lasso-x0) > 4px || abs(y - OrganizeUi.lasso-y0) > 4px;
        } else if (kind == 2 && OrganizeUi.lassoing) {
            OrganizeUi.lassoing = false;
            if (root.lasso-moved) {
                let bx = big.absolute-position.x;
                let by = big.absolute-position.y;
                root.lasso-done((OrganizeUi.lasso-x0 - bx) / big.width, (OrganizeUi.lasso-y0 - by) / big.width, (x - bx) / big.width, (y - by) / big.width, shift);
            } else {
                root.frame-selected(-1);
            }
        }
    }
    callback move-spread(int, int);
    callback cut-moved(int, int);
    callback layout-apply(int);
    callback layout-favorite(int);
    callback layout-reject(int);
    callback layout-list-changed(int);

    public function focus-main() {
        keys.focus();
    }

    // Abre o endereço no navegador do sistema (formulário de sugestões, spec SR).
    public function open-url(url: string) -> bool {
        return Platform.open-url(url);
    }

    // Começa a arrastar só depois de 6 px, para um clique não virar arrasto.
    function far(x: length, y: length) -> bool {
        abs(x - root.press-x) > 6px || abs(y - root.press-y) > 6px
    }

    // Onde o ponteiro está na lâmina grande, em frações da largura dela.
    function frac-x() -> float { (root.drag-x - big.absolute-position.x) / big.width }
    function frac-y() -> float { (root.drag-y - big.absolute-position.y) / big.width }

    // O menu nativo fica estável durante a edição (spec MV, regra 16): mudar o título ou o
    // "enabled" de um item faz o Slint 1.18 refazer a barra inteira e o Windows redimensionar a
    // janela duas vezes (~70 ms antes do primeiro quadro). Cada comando confere sozinho se pode rodar.
    MenuBar {
        Menu {
            title: "Arquivo";
            MenuItem { title: "Novo álbum…  (Ctrl+N)"; activated => { root.command("arquivo.novo"); } }
            MenuItem { title: "Abrir…  (Ctrl+O)"; activated => { root.command("arquivo.abrir"); } }
            Menu {
                title: "Abrir recente";
                for item in RecentsUi.menu: MenuItem { title: item.label; enabled: item.enabled; activated => { RecentsUi.open(item.index); } }
            }
            MenuItem { title: "Abrir o álbum de exemplo"; activated => { root.command("arquivo.exemplo"); } }
            MenuSeparator { }
            MenuItem { title: "Importar fotos…  (Ctrl+I)"; enabled: root.has-project; activated => { root.command("arquivo.importar"); } }
            MenuItem { title: "Importar uma pasta de fotos…"; enabled: root.has-project; activated => { root.command("arquivo.importar-pasta"); } }
            MenuItem { title: "Limpar recentes não fixados…"; enabled: RecentsUi.menu.length > 0; activated => { root.command("arquivo.limpar-recentes"); } }
            MenuSeparator { }
            MenuItem { title: "Fechar álbum  (Ctrl+W)"; enabled: root.has-project; activated => { root.command("arquivo.fechar"); } }
            MenuSeparator { }
            MenuItem { title: "Salvar  (Ctrl+S)"; enabled: root.has-project; activated => { root.command("arquivo.salvar"); } }
            MenuItem { title: "Salvar como…  (Ctrl+Shift+S)"; enabled: root.has-project; activated => { root.command("arquivo.salvar-como"); } }
            MenuSeparator { }
            MenuItem { title: "Exportar…  (Ctrl+E)"; enabled: root.has-project; activated => { root.command("arquivo.exportar"); } }
            MenuItem { title: "Procurar fotos ausentes…"; enabled: root.has-missing; activated => { root.command("arquivo.procurar-fotos"); } }
            MenuSeparator { }
            MenuItem { title: "Especificação do álbum…"; enabled: root.has-project; activated => { root.command("arquivo.especificacao"); } }
            MenuItem { title: "Montagem do álbum…"; enabled: root.has-project; activated => { root.command("arquivo.montagem"); } }
            MenuItem { title: "Presets…"; activated => { root.command("arquivo.presets"); } }
        }
        Menu {
            title: "Editar";
            MenuItem { title: "Desfazer  (Ctrl+Z)"; enabled: root.has-project; activated => { root.command("editar.desfazer"); } }
            MenuItem { title: "Refazer  (Ctrl+Y)"; enabled: root.has-project; activated => { root.command("editar.refazer"); } }
        }
        Menu {
            title: "Lâmina";
            MenuItem { title: "Próxima lâmina  (Page Down)"; enabled: root.has-project; activated => { root.command("lamina.proxima"); } }
            MenuItem { title: "Lâmina anterior  (Page Up)"; enabled: root.has-project; activated => { root.command("lamina.anterior"); } }
            MenuItem { title: "Primeira lâmina  (Home)"; enabled: root.has-project; activated => { root.command("lamina.primeira"); } }
            MenuItem { title: "Última lâmina  (End)"; enabled: root.has-project; activated => { root.command("lamina.ultima"); } }
            MenuSeparator { }
            MenuItem { title: "Novo texto  (T)"; enabled: root.has-project; activated => { root.command("lamina.novo-texto"); } }
            MenuItem { title: "Novo quadro de foto"; enabled: root.has-project; activated => { root.command("lamina.novo-quadro"); } }
            MenuItem { title: "Trazer para a frente"; enabled: root.has-project; activated => { root.command("lamina.frente"); } }
            MenuItem { title: "Enviar para trás"; enabled: root.has-project; activated => { root.command("lamina.tras"); } }
            MenuSeparator { }
            MenuItem { title: "Salvar como modelo…"; enabled: root.has-project; activated => { root.command("lamina.salvar-modelo"); } }
            MenuItem { title: "Meus modelos…"; activated => { root.command("lamina.modelos"); } }
        }
        Menu {
            title: "Layout";
            MenuItem { title: "Próximo layout  (→)"; enabled: root.has-project; activated => { root.command("layout.proximo"); } }
            MenuItem { title: "Layout anterior  (←)"; enabled: root.has-project; activated => { root.command("layout.anterior"); } }
            MenuItem { title: "Próximo da página esquerda  (↓)"; enabled: root.has-project; activated => { root.command("layout.esquerda-proximo"); } }
            MenuItem { title: "Anterior da página esquerda  (↑)"; enabled: root.has-project; activated => { root.command("layout.esquerda-anterior"); } }
            MenuItem { title: "Próximo da página direita  (Shift+↓)"; enabled: root.has-project; activated => { root.command("layout.direita-proximo"); } }
            MenuItem { title: "Anterior da página direita  (Shift+↑)"; enabled: root.has-project; activated => { root.command("layout.direita-anterior"); } }
            MenuSeparator { }
            MenuItem { title: "Espelhar lâmina  (E)"; enabled: root.has-project; activated => { root.command("layout.espelhar"); } }
            MenuItem { title: "Favoritar layout  (F)"; enabled: root.has-project; activated => { root.command("layout.favoritar"); } }
            MenuItem { title: "Rejeitar layout  (X)"; enabled: root.has-project; activated => { root.command("layout.rejeitar"); } }
            MenuItem { title: root.layout-list == 1 ? "Mostrar na ordem  (R)" : "Mostrar reordenadas  (R)"; enabled: root.has-project; activated => { root.command("layout.reordenadas"); } }
        }
        Menu {
            title: "Visualizar";
            MenuItem { title: root.guides ? "Esconder guias  (G)" : "Mostrar guias  (G)"; enabled: root.has-project; activated => { root.command("ver.guias"); } }
            MenuSeparator { }
            MenuItem { title: (root.spreads-open ? "✓ " : "    ") + "Faixa de lâminas  (Alt+1)"; enabled: root.has-project; activated => { root.command("ver.faixa-laminas"); } }
            MenuItem { title: (root.timeline-open ? "✓ " : "    ") + "Linha do tempo  (Alt+2)"; enabled: root.has-project; activated => { root.command("ver.linha-do-tempo"); } }
            MenuItem { title: (root.photos-open ? "✓ " : "    ") + "Fotos  (Alt+3)"; enabled: root.has-project; activated => { root.command("ver.fotos"); } }
            MenuSeparator { }
            MenuItem { title: (root.reduce-motion ? "✓ " : "    ") + "Reduzir movimento"; activated => { root.command("ver.reduzir-movimento"); } }
        }
        Menu {
            title: "Ajuda";
            MenuItem { title: "Verificar atualizações agora"; activated => { root.command("ajuda.verificar-atualizacoes"); } }
            MenuItem { title: (root.auto-updates ? "✓ " : "    ") + "Verificar atualizações automaticamente"; activated => { root.command("ajuda.atualizar-automaticamente"); } }
            MenuItem { title: (root.beta-updates ? "✓ " : "    ") + "Receber versões de teste (beta)"; activated => { root.command("ajuda.versoes-de-teste"); } }
            MenuSeparator { }
            MenuItem { title: "Enviar sugestão ou problema…"; activated => { root.command("ajuda.enviar-sugestao"); } }
            MenuItem { title: "Abrir pasta de registros"; activated => { root.command("ajuda.abrir-registros"); } }
            MenuSeparator { }
            MenuItem { title: "Sobre o Lamina"; activated => { root.command("ajuda.sobre"); } }
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (NewProjectUi.show || root.show-confirm || root.show-message || root.show-about || root.show-export || PresetUi.show-spec || PresetUi.show-name || PresetUi.show-list || ModelUi.show-name || ModelUi.show-list || RecentsUi.show-clear || root.busy-text != "") {
                return reject;
            }
            // Teclas especiais chegam como o caractere do Slint; o Rust traduz o nome.
            root.key(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt) ? accept : reject
        }

        VerticalLayout {
            // Barra do projeto.
            Rectangle {
                height: 44px;
                background: Theme.bar;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 8px;
                    spacing: 16px;
                    // Início: fecha o álbum e volta à tela inicial (spec TI, regra 6).
                    if root.has-project: BarButton { text: "Início"; clicked => { root.command("arquivo.fechar"); } }
                    Text {
                        text: root.project-title;
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Text { text: root.counter; color: Theme.muted; vertical-alignment: center; }
                    if root.counter-warning != "": Text { text: root.counter-warning; color: Theme.warning; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    BarButton { text: "Novo"; clicked => { root.command("arquivo.novo"); } }
                    BarButton { text: "Abrir"; clicked => { root.command("arquivo.abrir"); } }
                    BarButton { text: "Salvar"; enabled: root.can-save; clicked => { root.command("arquivo.salvar"); } }
                    BarButton { text: "Texto"; enabled: root.has-project; clicked => { root.command("lamina.novo-texto"); } }
                    BarButton { text: "Exportar"; primary: true; enabled: root.has-project; clicked => { root.command("arquivo.exportar"); } }
                }
            }

            if root.update-bar != "": UpdateBar {
                text: root.update-bar;
                restart => { root.update-restart(); }
                dismiss => { root.update-dismiss(); }
            }

            if root.notice != "": Rectangle {
                height: 30px;
                background: #4a3f1f;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 8px;
                    spacing: 12px;
                    Text { text: root.notice; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    if root.has-missing: BarButton { text: "Procurar fotos…"; clicked => { root.command("arquivo.procurar-fotos"); } }
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                // Lâmina atual.
                area := Rectangle {
                    horizontal-stretch: 1;
                    property <length> canvas-width: root.current.aspect > 0
                        ? min(self.width - 48px, (self.height - 48px) / root.current.aspect) : 0px;
                    // Clique fora dos quadros: desmarca e sai do modo recorte.
                    // Clique fora dos quadros: desmarca e sai do modo recorte. Duplo clique abre o
                    // modo organizar; arrastar no modo faz o laço (spec EG).
                    TouchArea {
                        clicked => {
                            if (!root.lasso-moved) {
                                root.frame-selected(-1);
                            }
                            root.focus-main();
                        }
                        double-clicked => { root.frame-double(-1); root.focus-main(); }
                        moved => { root.background-event(1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, false); }
                        pointer-event(e) => {
                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                root.background-event(0, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, e.modifiers.shift);
                            }
                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                                root.background-event(2, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, e.modifiers.shift);
                            }
                        }
                    }
                    if root.hint != "": Text {
                        y: parent.height - 22px;
                        text: root.hint;
                        color: Theme.muted;
                        font-size: 12px;
                    }
                    // A lâmina que sai, esmaecendo e deslizando para o lado oposto (spec MV).
                    if root.has-leaving && root.nav-running: SpreadCanvas {
                        x: (parent.width - self.width) / 2 - root.nav-dir * 32px * root.nav-e;
                        width: area.canvas-width;
                        height: area.canvas-width * root.leaving.aspect;
                        data: root.leaving;
                        guides: root.guides;
                        opacity: 1 - root.nav-e;
                    }
                    // Sempre na árvore (some sem projeto) para o arrastar achar a posição dela.
                    big := SpreadCanvas {
                        // Entra deslizando 32 px e esmaecendo, na direção da navegação.
                        x: (parent.width - self.width) / 2 + (root.nav-running ? root.nav-dir * 32px * (1 - root.nav-e) : 0px);
                        opacity: root.nav-running ? root.nav-e : 1;
                        cropping: root.crop-frame;
                        has-preview: root.has-preview;
                        preview: root.preview;
                        preview-img: root.preview-img;
                        frame-double(i) => { root.frame-double(i); root.focus-main(); }
                        crop-drag(dx, dy) => { root.crop-drag(dx, dy); }
                        crop-end() => { root.crop-end(); root.focus-main(); }
                        crop-wheel(n) => { root.crop-wheel(n); }
                        grab(i, n, x, y, w) => { root.frame-grab(i, n, x, y, w); }
                        grab-move(x, y, alt, shift) => { root.frame-drag(x, y, alt, shift); }
                        organizing: OrganizeUi.on;
                        organize-press(i, ctrl, shift, x, y, w) => { root.organize-press(i, ctrl, shift, x, y, w); }
                        grab-end => { root.frame-release(); root.focus-main(); }
                        hover-fx <=> root.hover-fx;
                        visible: root.has-project;
                        width: area.canvas-width;
                        height: area.canvas-width * root.current.aspect;
                        data: root.current;
                        guides: root.guides;
                        interactive: true;
                        selected: root.selected-frame;
                        drop-shadow-blur: 16px;
                        drop-shadow-color: #00000080;
                        frame-down(i, x, y) => {
                            root.press-x = x;
                            root.press-y = y;
                            root.drag-from = i;
                        }
                        back-press(k, x, y, shift) => { root.background-event(k, x, y, shift); }
                        frame-move(i, x, y, img) => {
                            // No modo organizar nenhuma foto troca de quadro (spec EG, regra 4).
                            if (root.drag-kind == 0 && root.far(x, y) && !OrganizeUi.on) {
                                root.drag-kind = 2;
                                root.drag-img = img;
                            }
                            root.drag-x = x;
                            root.drag-y = y;
                        }
                        frame-up(i, x, y, ctrl, shift) => {
                            if (root.drag-kind == 2) {
                                root.land();
                                root.drop-frame(root.drag-from, root.frac-x(), root.frac-y());
                            } else {
                                root.frame-clicked(i, ctrl, shift);
                            }
                            root.drag-kind = 0;
                            root.focus-main();
                        }
                    }
                    // Destaque do quadro de destino durante o arrasto: o mesmo da soltura (spec MV,
                    // regra 12).
                    if root.drag-kind == 1 || root.drag-kind == 2: Rectangle {
                        property <BoxData> t: root.drop-at(root.frac-x(), root.frac-y());
                        visible: self.t.w > 0;
                        x: big.x + self.t.x * big.width;
                        y: big.y + self.t.y * big.width;
                        width: self.t.w * big.width;
                        height: self.t.h * big.width;
                        border-width: 3px;
                        border-color: #ffd23f;
                    }
                    if root.has-project && root.spreads.length == 0: EmptyAlbum {
                        photos: root.photos.length;
                        import => { root.command("arquivo.importar"); }
                    }
                    // O modo organizar: os quadros selecionados e a barra da lâmina em destaque.
                    if OrganizeUi.on: OrganizeMarks {
                        x: big.x;
                        y: big.y;
                        width: big.width;
                        height: big.height;
                        unit: big.width;
                    }
                    if OrganizeUi.on: OrganizeBar {
                        y: 0;
                        width: parent.width;
                    }
                    if !root.has-project: WelcomeScreen {
                        command(name) => { root.command(name); }
                    }
                }

                // Painel da direita: layouts (padrão) e informações.
                if root.has-project: RightPanel {
                    tab <=> root.panel-tab;
                    layouts: root.layouts;
                    layout-in-use: root.layout-in-use;
                    layout-list: root.layout-list;
                    has-reordered: root.has-reordered;
                    layout-count: root.layout-count;
                    layout-notice: root.layout-notice;
                    layout-explanation: root.layout-explanation;
                    aspect: root.current.aspect;
                    history: root.history;
                    history-pos: root.history-pos;
                    info-album: root.info-album;
                    info-spread: root.info-spread;
                    info-warnings: root.info-warnings;
                    info-frame: root.info-frame;
                    info-frame-warn: root.info-frame-warn;
                    info-photo: root.info-photo;
                    layout-apply(i) => { root.layout-apply(i); }
                    layout-favorite(i) => { root.layout-favorite(i); }
                    layout-reject(i) => { root.layout-reject(i); }
                    layout-list-changed(i) => { root.layout-list-changed(i); }
                    history-go(i) => { root.history-go(i); }
                    done => { root.focus-main(); }
                }
            }
            // As três faixas de baixo (spec PN): cabeçalho com nome e resumo, e o conteúdo, que
            // recolhe. A faixa de lâminas fica sempre na árvore (só some sem projeto ou
            // recolhida) para rolar até a lâmina atual.
            if root.has-project: StripHeader {
                name: "Lâminas";
                summary: root.strip-spreads;
                open: root.spreads-open;
                toggled => { root.command("ver.faixa-laminas"); }
            }
            spread-strip := SpreadStrip {
                visible: root.has-project && root.spreads-open;
                height: self.visible ? 128px : 0px;
                spreads: root.spreads;
                current-index: root.current-index;
                current-aspect: root.current.aspect;
                spread-shift(f, g, i) => { return root.spread-shift(f, g, i); }
                drag-kind <=> root.drag-kind;
                drag-from <=> root.drag-from;
                drag-x <=> root.drag-x;
                drag-y <=> root.drag-y;
                press-x <=> root.press-x;
                press-y <=> root.press-y;
                go-to(i) => { root.go-to(i); }
                move-spread(from, to) => { root.move-spread(from, to); }
                focus-main => { root.focus-main(); }
            }
            if root.has-project: StripHeader {
                name: "Linha do tempo";
                summary: root.strip-timeline;
                open: root.timeline-open;
                toggled => { root.command("ver.linha-do-tempo"); }
            }
            if root.has-project && root.timeline-open: TimelineStrip {
                height: 58px;
                timeline: root.timeline;
                press-x <=> root.press-x;
                cut-moved(spread, delta) => { root.cut-moved(spread, delta); }
                focus-main => { root.focus-main(); }
            }
            if root.has-project: StripHeader {
                name: "Fotos";
                summary: root.strip-photos;
                open: root.photos-open;
                toggled => { root.command("ver.fotos"); }
                FilterTab { text: "Todas"; active: root.filter == 0; clicked => { root.filter-changed(0); } }
                FilterTab { text: "Usadas"; active: root.filter == 1; clicked => { root.filter-changed(1); } }
                FilterTab { text: "Não usadas"; active: root.filter == 2; clicked => { root.filter-changed(2); } }
                BarButton { text: "+ Fotos"; clicked => { root.command("arquivo.importar"); } }
            }
            if root.has-project && root.photos-open: PhotoStrip {
                height: 144px;
                photos: root.photos;
                selected-photo: root.selected-photo;
                drag-kind <=> root.drag-kind;
                drag-from <=> root.drag-from;
                drag-img <=> root.drag-img;
                drag-x <=> root.drag-x;
                drag-y <=> root.drag-y;
                press-x <=> root.press-x;
                press-y <=> root.press-y;
                photo-double-clicked(i) => { root.photo-double-clicked(i); }
                photo-pressed(i, ctrl, shift) => { root.photo-pressed(i, ctrl, shift); }
                dropped => {
                    // Sobre a faixa de lâminas, uma lâmina nova no vão (spec IM, regra 7).
                    if (spread-strip.visible && spread-strip.photo-gap >= 0) {
                        root.drop-photos-gap(root.drag-from, spread-strip.photo-gap);
                    } else {
                        root.land();
                        root.drop-photo(root.drag-from, root.frac-x(), root.frac-y());
                    }
                }
                focus-main => { root.focus-main(); }
            }
        }
    }

    if NewProjectUi.show: NewProjectDialog {
        closed => { root.focus-main(); }
    }
    if root.show-confirm: ConfirmDialog {
        name: root.project-title;
        answer(choice) => { root.confirm(choice); }
    }
    if root.show-export: ExportDialog {
        folder: root.ex-folder;
        all-spreads <=> root.ex-all;
        range <=> root.ex-range;
        pages <=> root.ex-pages;
        quality <=> root.ex-quality;
        format <=> root.ex-format;
        marks <=> root.ex-marks;
        adobe <=> root.ex-adobe;
        error: root.ex-error;
        step: root.ex-step;
        warnings: root.ex-warnings;
        album-warning: root.ex-album;
        replace-text: root.ex-replace-text;
        pick-folder => { root.ex-pick-folder(); }
        changed => { root.ex-changed(); }
        export => { root.ex-export(); }
        go-to(i) => { root.ex-go-to(i); }
        ignore(i) => { root.ex-ignore(i); }
        proceed => { root.ex-proceed(); }
        replace => { root.ex-replace(); }
        back => { root.ex-back(); }
        cancel => {
            root.show-export = false;
            root.focus-main();
        }
    }
    if PresetUi.show-list: PresetsDialog { }
    if PresetUi.show-name: PresetNameDialog { }
    if ModelUi.show-name: ModelNameDialog { }
    if ModelUi.show-list: ModelsDialog { }
    if root.show-message: MessageDialog {
        title: root.message-title;
        message: root.message-text;
        details: root.message-details;
        folder: root.message-folder;
        open-folder => { root.open-folder(); }
        send-problem => { root.command("ajuda.enviar-sugestao"); }
        close => {
            root.show-message = false;
            root.focus-main();
        }
    }
    if root.show-about: AboutDialog {
        version: root.version;
        close => {
            root.show-about = false;
            root.focus-main();
        }
    }
    if RecentsUi.show-clear: ClearRecentsDialog {
        closed => { root.focus-main(); }
    }
    if root.drag-kind == 1 || root.drag-kind == 2 || root.landing: DragGhost {
        ghost: root.ghost;
        landing: root.landing;
        width: root.landing ? root.land-w0 + (root.land-w1 - root.land-w0) * root.land-e : root.ghost.w * 1px;
        height: root.landing ? root.land-h0 + (root.land-h1 - root.land-h0) * root.land-e : root.ghost.h * 1px;
        x: root.landing ? root.land-x0 + (root.land-x1 - root.land-x0) * root.land-e : root.drag-x - self.width / 2;
        y: root.landing ? root.land-y0 + (root.land-y1 - root.land-y0) * root.land-e : root.drag-y - self.height / 2;
        opacity: root.landing ? 0.85 * (1 - root.land-p) + 0.15 : 0.85;
    }
    if OrganizeUi.lassoing && root.lasso-moved: LassoBox { }
    if ImportUi.dropping: DropOverlay { }
    if root.busy-text != "": BusyOverlay {
        text: root.busy-text;
    }
}

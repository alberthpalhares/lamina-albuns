// Painel de layouts (spec TL, seção 4): as opções do motor para a lâmina atual, a em uso
// destacada, favoritos com estrela e a nota explicada. Só desenho: as listas vêm do editor.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { SpreadCanvas, SpreadData } from "canvas.slint";
import { Motion } from "motion.slint";

export struct LayoutItem {
    data: SpreadData,
    title: string,
    score: string,
    favorite: bool,
}

component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked();
    height: 30px;
    Text {
        text: root.text;
        color: !root.enabled ? #6b6b6b : root.active ? Theme.selected : Theme.muted;
        font-weight: root.active ? 700 : 400;
    }
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: root.active ? Theme.selected : transparent;
    }
    TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component SmallButton inherits Rectangle {
    in property <string> text;
    in property <color> glyph-color: Theme.text;
    callback clicked();
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background: touch.has-hover ? #00000099 : #00000060;
    Text { text: root.text; color: root.glyph-color; font-size: 13px; }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component LayoutsPanel inherits VerticalLayout {
    in property <[LayoutItem]> items;
    in property <int> in-use;
    in property <int> list;
    in property <bool> has-reordered;
    in property <string> count;
    in property <string> notice;
    in property <string> explanation;
    in property <float> aspect;
    callback apply(int);
    callback favorite(int);
    callback reject(int);
    callback list-changed(int);

    // A opção em uso fica visível: a lista rola até ela (as setas trocam sem o mouse).
    changed in-use => {
        if (root.in-use < 0) {
            return;
        }
        let top = root.in-use * item-height;
        if (top + options.content-y < 0px || top + item-height + options.content-y > options.visible-height) {
            root.follow(max(min(0px, options.visible-height / 2 - top - item-height / 2), options.visible-height - root.items.length * item-height));
        }
    }

    // Rolagem suave pelo relógio (spec MV, regra 10): a barra responde na hora e rolar à mão para.
    property <bool> sc-running;
    property <duration> sc-t0;
    property <length> sc-from;
    property <length> sc-to;
    property <float> sc-p: self.sc-running ? min(1, (animation-tick() - self.sc-t0) / max(1ms, Motion.scroll-ms * 1ms)) : 1;
    changed sc-p => {
        if (self.sc-running) {
            options.content-y = self.sc-from + (self.sc-to - self.sc-from) * (1 - pow(1 - self.sc-p, 3));
            if (self.sc-p >= 1) {
                self.sc-running = false;
            }
        }
    }
    function follow(target: length) {
        if (Motion.on && Motion.scroll-ms > 0) {
            root.sc-from = options.content-y;
            root.sc-to = target;
            root.sc-t0 = animation-tick();
            root.sc-running = true;
        } else {
            options.content-y = target;
        }
    }

    property <length> item-height: (options.visible-width - 20px) * root.aspect + 40px;
    spacing: 6px;

    HorizontalLayout {
        spacing: 16px;
        Tab { text: "Na ordem"; active: root.list == 0; clicked => { root.list-changed(0); } }
        Tab {
            text: "Reordenadas";
            active: root.list == 1;
            enabled: root.has-reordered;
            clicked => { root.list-changed(1); }
        }
        Rectangle { horizontal-stretch: 1; }
        Text { text: root.count; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
    }
    if root.notice != "": Text { text: root.notice; color: Theme.warning; wrap: word-wrap; }

    options := ListView {
        vertical-stretch: 1;
        scrolled => { root.sc-running = false; }
        for item[i] in root.items: Rectangle {
            height: root.item-height;
            VerticalLayout {
                padding: 6px;
                spacing: 4px;
                Rectangle {
                    border-radius: 4px;
                    border-width: 2px;
                    border-color: i == root.in-use ? Theme.selected : transparent;
                    height: self.width * root.aspect + 4px;
                    canvas := SpreadCanvas {
                        x: 2px;
                        y: 2px;
                        width: parent.width - 4px;
                        height: parent.height - 4px;
                        data: item.data;
                        small: true;
                    }
                    TouchArea { clicked => { root.apply(i); } }
                    HorizontalLayout {
                        alignment: end;
                        padding: 6px;
                        spacing: 4px;
                        height: 34px;
                        y: 0;
                        SmallButton {
                            text: item.favorite ? "★" : "☆";
                            glyph-color: item.favorite ? Theme.warning : Theme.text;
                            clicked => { root.favorite(i); }
                        }
                        SmallButton { text: "×"; clicked => { root.reject(i); } }
                    }
                }
                HorizontalLayout {
                    Text {
                        text: (i + 1) + ". " + item.title;
                        color: i == root.in-use ? Theme.selected : Theme.text;
                        font-size: 12px;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text { text: item.score; color: Theme.muted; font-size: 12px; }
                }
            }
        }
    }
    if root.explanation != "": Text {
        text: root.explanation;
        color: Theme.muted;
        font-size: 12px;
        wrap: word-wrap;
    }
}

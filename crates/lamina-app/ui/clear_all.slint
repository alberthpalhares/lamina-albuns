// Limpar as lâminas (spec LL): a pergunta antes de tirar as fotos de todas as lâminas ou de apagar
// todas elas. O texto e o botão vêm do Rust; a decisão é do editor.

import { Button } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Shade, Panel } from "widgets.slint";

export global ClearUi {
    in-out property <bool> show;
    in property <string> title;
    in property <string> message;
    in property <string> action;
    callback confirmed();
}

export component ClearAllDialog inherits Shade {
    callback closed();
    Panel {
        width: 460px;
        height: 180px;
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Text { text: ClearUi.title; font-size: 18px; font-weight: 700; color: Theme.text; wrap: word-wrap; }
            Text { text: ClearUi.message; color: Theme.muted; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button { text: "Cancelar"; clicked => { ClearUi.show = false; root.closed(); } }
                Button { text: ClearUi.action; primary: true; clicked => { ClearUi.show = false; ClearUi.confirmed(); root.closed(); } }
            }
        }
    }
}

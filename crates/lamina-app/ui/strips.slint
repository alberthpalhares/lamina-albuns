// As faixas de baixo da janela (spec PN): lâminas, linha do tempo e fotos. Cada uma tem um
// cabeçalho (nome e resumo), um fundo próprio e pode ser recolhida. O estado do arrastar mora na
// janela principal e chega aqui ligado nos dois sentidos.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { SpreadCanvas, SpreadData } from "canvas.slint";
import { Motion } from "motion.slint";

export struct PhotoData {
    img: image,
    name: string,
    uses: int,
    selected: bool,
}

// Uma posição da timeline: uma foto, ou o corte depois da lâmina `spread`.
export struct TimelineItem {
    img: image,
    cut: bool,
    spread: int,
}

// Fundos das faixas: a de lâminas a mais clara, a de fotos a mais escura (spec PN, seção 4).
export global StripTheme {
    out property <color> header: #1a1a1a;
    out property <color> header-hover: #242424;
    out property <color> line: #3a3a3a;
    out property <color> spreads: #343434;
    out property <color> timeline: #2a2a2a;
    out property <color> photos: #202020;
}

// Cabeçalho: seta, nome em negrito e resumo. Clique recolhe ou abre; o que vier dentro (as abas
// do navegador) fica à direita.
export component StripHeader inherits Rectangle {
    in property <string> name;
    in property <string> summary;
    in property <bool> open;
    callback toggled();
    height: 26px;
    background: touch.has-hover ? StripTheme.header-hover : StripTheme.header;
    touch := TouchArea { clicked => { root.toggled(); } }
    Rectangle { y: 0; height: 1px; background: StripTheme.line; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;
        Text { text: root.open ? "▾" : "▸"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
        Text { text: root.name; color: Theme.text; font-size: 12px; font-weight: 700; vertical-alignment: center; }
        Text {
            text: root.summary;
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        @children
    }
}

// Faixa de lâminas: a atual com contorno claro e o número embaixo de cada uma.
export component SpreadStrip inherits Rectangle {
    in property <[SpreadData]> spreads;
    in property <int> current-index;
    in property <float> current-aspect;
    in-out property <int> drag-kind;
    in-out property <int> drag-from;
    in-out property <length> drag-x;
    in-out property <length> drag-y;
    in-out property <length> press-x;
    in-out property <length> press-y;
    callback go-to(int);
    // A lâmina arrastada e o vão onde ela foi solta (0 = antes da primeira).
    callback move-spread(int, int);
    // Quantos lugares a lâmina anda durante o arrasto (lâmina arrastada, vão, lâmina).
    pure callback spread-shift(int, int, int) -> int;
    // O vão mais perto do ponteiro durante o arrasto de uma lâmina.
    function gap() -> int {
        let item = 84px / max(0.01, root.current-aspect) + 16px;
        let at = (root.drag-x - strip-scroll.absolute-position.x - strip-scroll.content-x - 10px) / item;
        max(0, min(root.spreads.length, round(at)))
    }
    callback focus-main();
    background: StripTheme.spreads;

    // Começa a arrastar só depois de 6 px, para um clique não virar arrasto.
    function far(x: length, y: length) -> bool {
        abs(x - root.press-x) > 6px || abs(y - root.press-y) > 6px
    }

    // A lâmina atual fica visível na faixa (spec JP, regra 7): se saiu da área vista, a faixa
    // rola até deixá-la no meio.
    changed current-index => {
        if (root.current-aspect <= 0) {
            return;
        }
        let item = 84px / root.current-aspect + 6px + 10px;
        let left = 10px + root.current-index * item;
        let shown = strip-scroll.visible-width;
        if (left + strip-scroll.content-x < 0px || left + item + strip-scroll.content-x > shown) {
            root.follow(max(min(0px, shown / 2 - left - item / 2), shown - strip.preferred-width));
        }
    }

    // Rolagem suave pelo relógio (spec MV, regra 10; ADR 0011, decisão 6): a barra continua
    // respondendo na hora e rolar à mão para o acompanhamento.
    property <bool> sc-running;
    property <duration> sc-t0;
    property <length> sc-from;
    property <length> sc-to;
    property <float> sc-p: self.sc-running ? min(1, (animation-tick() - self.sc-t0) / max(1ms, Motion.scroll-ms * 1ms)) : 1;
    changed sc-p => {
        if (self.sc-running) {
            strip-scroll.content-x = self.sc-from + (self.sc-to - self.sc-from) * (1 - pow(1 - self.sc-p, 3));
            if (self.sc-p >= 1) {
                self.sc-running = false;
            }
        }
    }
    function follow(target: length) {
        if (Motion.on && Motion.scroll-ms > 0) {
            root.sc-from = strip-scroll.content-x;
            root.sc-to = target;
            root.sc-t0 = animation-tick();
            root.sc-running = true;
        } else {
            strip-scroll.content-x = target;
        }
    }
    // A roda vertical rola a faixa; giros seguidos somam ao destino anterior.
    function wheel(dy: length) {
        let base = root.sc-running ? root.sc-to : strip-scroll.content-x;
        root.follow(max(strip-scroll.visible-width - strip.preferred-width, min(0px, base + dy)));
    }

    strip-scroll := ScrollView {
        // Arrastar com o botão apertado é para mover a lâmina, não para rolar a faixa.
        mouse-drag-pan-enabled: false;
        content-width: strip.preferred-width;
        content-height: self.height;
        scrolled => { root.sc-running = false; }
        TouchArea {
            width: strip.preferred-width;
            height: strip-scroll.height;
            scroll-event(e) => {
                if (e.delta-y != 0) {
                    root.wheel(e.delta-y);
                    return accept;
                }
                reject
            }
        }
        strip := HorizontalLayout {
            padding: 8px;
            padding-left: 10px;
            padding-right: 10px;
            spacing: 10px;
            for s[i] in root.spreads: VerticalLayout {
                spacing: 4px;
                Rectangle {
                    width: 84px / s.aspect + 6px;
                    height: 90px;
                    // Reordenar (spec MV, regra 12): as vizinhas abrem espaço durante o arrasto.
                    property <float> off: root.drag-kind == 3 ? root.spread-shift(root.drag-from, root.gap(), i) : 0;
                    animate off {
                        duration: Motion.reorder-ms * 1ms;
                        easing: cubic-bezier(0.2, 0, 0, 1);
                        enabled: Motion.on;
                    }
                    Rectangle {
                        x: parent.off * (84px / s.aspect + 16px);
                        width: parent.width;
                        height: parent.height;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: i == root.current-index ? Theme.selected : transparent;
                        opacity: root.drag-kind == 3 && root.drag-from == i ? 0.35 : 1;
                        SpreadCanvas {
                            x: 3px;
                            y: 3px;
                            width: parent.width - 6px;
                            height: parent.height - 6px;
                            data: s;
                            small: true;
                        }
                        if s.warning: Rectangle {
                            x: parent.width - 21px;
                            y: 6px;
                            width: 14px;
                            height: 14px;
                            border-radius: 7px;
                            background: Theme.warning;
                            Text { text: "!"; color: black; font-size: 10px; font-weight: 700; }
                        }
                    }
                    TouchArea {
                        moved => {
                            let x = self.absolute-position.x + self.mouse-x;
                            let y = self.absolute-position.y + self.mouse-y;
                            if (root.drag-kind == 0 && root.far(x, y)) {
                                root.drag-kind = 3;
                                root.drag-from = i;
                            }
                            root.drag-x = x;
                            root.drag-y = y;
                        }
                        pointer-event(e) => {
                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                root.press-x = self.absolute-position.x + self.mouse-x;
                                root.press-y = self.absolute-position.y + self.mouse-y;
                            }
                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                                if (root.drag-kind == 3) {
                                    // O editor decide a posição pelo vão (spec MV, MV-B23).
                                    root.move-spread(i, root.gap());
                                } else {
                                    root.go-to(i);
                                }
                                root.drag-kind = 0;
                                root.focus-main();
                            }
                        }
                    }
                }
                Text {
                    text: i + 1;
                    horizontal-alignment: center;
                    color: i == root.current-index ? Theme.selected : Theme.muted;
                    font-size: 12px;
                    font-weight: i == root.current-index ? 700 : 400;
                }
            }
        }
        // Marcador no vão onde a lâmina vai ficar.
        if root.drag-kind == 3: Rectangle {
            x: 10px + root.gap() * (84px / max(0.01, root.current-aspect) + 16px) - 7px;
            y: 8px;
            width: 4px;
            height: 90px;
            border-radius: 2px;
            background: Theme.selected;
        }
    }
}

// Linha do tempo (spec FQ, regra 8): as fotos na ordem do álbum e um corte entre as lâminas.
export component TimelineStrip inherits Rectangle {
    in property <[TimelineItem]> timeline;
    in-out property <length> press-x;
    callback cut-moved(int, int);
    callback focus-main();
    background: StripTheme.timeline;
    Rectangle { y: 0; height: 1px; background: StripTheme.line; }

    // A roda vertical rola a faixa (spec MV, regra 10), suave pelo relógio; giros seguidos somam.
    property <bool> sc-running;
    property <duration> sc-t0;
    property <length> sc-from;
    property <length> sc-to;
    property <float> sc-p: self.sc-running ? min(1, (animation-tick() - self.sc-t0) / max(1ms, Motion.scroll-ms * 1ms)) : 1;
    changed sc-p => {
        if (self.sc-running) {
            line-scroll.content-x = self.sc-from + (self.sc-to - self.sc-from) * (1 - pow(1 - self.sc-p, 3));
            if (self.sc-p >= 1) {
                self.sc-running = false;
            }
        }
    }
    function wheel(dy: length) {
        let base = root.sc-running ? root.sc-to : line-scroll.content-x;
        let target = max(line-scroll.visible-width - line.preferred-width, min(0px, base + dy));
        if (Motion.on && Motion.scroll-ms > 0) {
            root.sc-from = line-scroll.content-x;
            root.sc-to = target;
            root.sc-t0 = animation-tick();
            root.sc-running = true;
        } else {
            line-scroll.content-x = target;
        }
    }
    line-scroll := ScrollView {
        // Arrastar é para levar a foto (ou o corte), não para rolar.
        mouse-drag-pan-enabled: false;
        content-width: line.preferred-width;
        content-height: self.height;        scrolled => { root.sc-running = false; }
        TouchArea {
            width: line.preferred-width;
            height: line-scroll.height;
            scroll-event(e) => {
                if (e.delta-y != 0) {
                    root.wheel(e.delta-y);
                    return accept;
                }
                reject
            }
        }
        line := HorizontalLayout {
            padding: 6px;
            spacing: 2px;
            for t in root.timeline: Rectangle {
                width: t.cut ? 14px : 46px;
                if !t.cut: Image {
                    width: 44px;
                    height: 44px;
                    source: t.img;
                    image-fit: contain;
                }
                if t.cut: Rectangle {
                    cut-touch := TouchArea {
                        mouse-cursor: ew-resize;
                        pointer-event(e) => {
                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                root.press-x = self.absolute-position.x + self.mouse-x;
                            }
                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                                let dx = self.absolute-position.x + self.mouse-x - root.press-x;
                                root.cut-moved(t.spread, round(dx / 48px));
                                root.focus-main();
                            }
                        }
                    }
                    Rectangle {
                        x: 5px;
                        width: 4px;
                        border-radius: 2px;
                        background: cut-touch.has-hover || cut-touch.pressed ? Theme.selected : Theme.muted;
                    }
                }
            }
        }
    }
}

// Navegador de fotos (as abas Todas, Usadas, Não usadas ficam no cabeçalho).
export component PhotoStrip inherits Rectangle {
    in property <[PhotoData]> photos;
    in property <int> selected-photo;
    in-out property <int> drag-kind;
    in-out property <int> drag-from;
    in-out property <image> drag-img;
    in-out property <length> drag-x;
    in-out property <length> drag-y;
    in-out property <length> press-x;
    in-out property <length> press-y;
    callback photo-double-clicked(int);
    callback photo-pressed(int, bool, bool);
    // Uma foto foi solta fora do navegador: a janela calcula onde.
    callback dropped();
    callback focus-main();
    background: StripTheme.photos;

    function far(x: length, y: length) -> bool {
        abs(x - root.press-x) > 6px || abs(y - root.press-y) > 6px
    }

    // A roda vertical rola a faixa (spec MV, regra 10), suave pelo relógio; giros seguidos somam.
    property <bool> sc-running;
    property <duration> sc-t0;
    property <length> sc-from;
    property <length> sc-to;
    property <float> sc-p: self.sc-running ? min(1, (animation-tick() - self.sc-t0) / max(1ms, Motion.scroll-ms * 1ms)) : 1;
    changed sc-p => {
        if (self.sc-running) {
            photo-scroll.content-x = self.sc-from + (self.sc-to - self.sc-from) * (1 - pow(1 - self.sc-p, 3));
            if (self.sc-p >= 1) {
                self.sc-running = false;
            }
        }
    }
    function wheel(dy: length) {
        let base = root.sc-running ? root.sc-to : photo-scroll.content-x;
        let target = max(photo-scroll.visible-width - browser.preferred-width, min(0px, base + dy));
        if (Motion.on && Motion.scroll-ms > 0) {
            root.sc-from = photo-scroll.content-x;
            root.sc-to = target;
            root.sc-t0 = animation-tick();
            root.sc-running = true;
        } else {
            photo-scroll.content-x = target;
        }
    }
    photo-scroll := ScrollView {
        // Arrastar é para levar a foto (ou o corte), não para rolar.
        mouse-drag-pan-enabled: false;
        content-width: browser.preferred-width;
        content-height: self.height;        scrolled => { root.sc-running = false; }
        TouchArea {
            width: browser.preferred-width;
            height: photo-scroll.height;
            scroll-event(e) => {
                if (e.delta-y != 0) {
                    root.wheel(e.delta-y);
                    return accept;
                }
                reject
            }
        }
        browser := HorizontalLayout {
            padding: 8px;
            spacing: 8px;
            for p[i] in root.photos: Rectangle {
                width: 140px;
                height: 120px;
                background: p.selected ? #4fc3f740 : i == root.selected-photo ? #ffffff1f : transparent;
                border-radius: 4px;
                Image {
                    y: 4px;
                    width: parent.width - 8px;
                    height: 92px;
                    source: p.img;
                    image-fit: contain;
                }
                Text {
                    x: 6px;
                    y: parent.height - 20px;
                    width: parent.width - 36px;
                    text: p.name;
                    color: Theme.muted;
                    font-size: 11px;
                    overflow: elide;
                }
                Text {
                    x: parent.width - 26px;
                    y: parent.height - 20px;
                    text: p.uses == 0 ? "–" : "×" + p.uses;
                    color: p.uses == 0 ? Theme.muted : Theme.text;
                    font-size: 11px;
                }
                TouchArea {
                    double-clicked => { root.photo-double-clicked(i); }
                    moved => {
                        let x = self.absolute-position.x + self.mouse-x;
                        let y = self.absolute-position.y + self.mouse-y;
                        if (root.drag-kind == 0 && root.far(x, y)) {
                            root.drag-kind = 1;
                            root.drag-from = i;
                            root.drag-img = p.img;
                        }
                        root.drag-x = x;
                        root.drag-y = y;
                    }
                    pointer-event(e) => {
                        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                            root.press-x = self.absolute-position.x + self.mouse-x;
                            root.press-y = self.absolute-position.y + self.mouse-y;
                        }
                        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                            if (root.drag-kind == 1) {
                                root.dropped();
                            } else {
                                root.photo-pressed(i, e.modifiers.control, e.modifiers.shift);
                            }
                            root.drag-kind = 0;
                            root.focus-main();
                        }
                    }
                }
            }
        }
    }
}

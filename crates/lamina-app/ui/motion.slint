// Movimento (spec MV, ADR 0011, decisão 5): as durações em ms e o interruptor num lugar só. O
// Rust preenche a partir do editor; "Reduzir movimento" zera as durações e desliga.

export global Motion {
    in property <bool> on: true;
    // Foto que continua na lâmina desliza; foto que entra ou sai esmaece.
    in property <int> slide-ms: 180;
    in property <int> fade-ms: 120;
    // Ir para outra lâmina; faixa e painel acompanhando.
    in property <int> navigate-ms: 200;
    in property <int> scroll-ms: 250;
    // Fantasma que pousa; foto nítida chegando; lâminas abrindo espaço.
    in property <int> land-ms: 150;
    in property <int> sharp-ms: 120;
    in property <int> reorder-ms: 150;
    // A faixa de layouts desce e sobe (spec FL).
    in property <int> band-ms: 200;
    // A janela (ou a borda do painel da direita) está mudando de tamanho: a lâmina acompanha sem
    // animar, até 150 ms depois da última mudança (spec FB, regra 6).
    in property <bool> resizing;
}
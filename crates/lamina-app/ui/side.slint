// O painel da direita: as abas (Detalhes, Aparência, Quadro, Histórico) e a aba Detalhes, o painel
// contextual da spec AF (o álbum sem seleção; a foto com uma foto). As outras abas moram em
// look.slint, frame.slint e history.slint; os layouts ficam na faixa (band.slint, spec FL).

import { Theme, Type } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { FocusRing } from "widgets.slint";
import { PhotoUi, PhotoSection } from "photo.slint";

// Uma linha da aba Detalhes: o título e o valor.
export struct DetailRow {
    title: string,
    value: string,
}

component Tab inherits Rectangle {
    accessible-role: tab;
    accessible-label: root.text;
    accessible-checked: root.active;
    accessible-action-default => { root.clicked(); }
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 30px;
    width: label.preferred-width;
    label := Text {
        text: root.text;
        font-size: Type.small;
        color: root.active ? Theme.text-strong : Theme.text-2;
        font-weight: root.active ? Type.semibold : Type.regular;
    }
    TouchArea { clicked => { root.clicked(); } }
    focus := FocusScope {
        x: 0;
        width: 0;
        key-pressed(e) => {
            if (e.text == Key.Space || e.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    FocusRing { shown: focus.has-focus; x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; }
}

// A ordem na tela não é a dos números: 1 = Detalhes (a de partida), 2 = Aparência, 4 = Quadro,
// 3 = Histórico (os números ficaram da ordem em que as abas chegaram; o 0 era a aba Layouts, que
// virou a faixa de layouts, spec FL).
export component PanelTabs inherits HorizontalLayout {
    in-out property <int> tab;
    spacing: 10px;
    Tab { text: "Detalhes"; active: root.tab == 1; clicked => { root.tab = 1; } }
    Tab { text: "Aparência"; active: root.tab == 2; clicked => { root.tab = 2; } }
    Tab { text: "Quadro"; active: root.tab == 4; clicked => { root.tab = 4; } }
    Tab { text: "Histórico"; active: root.tab == 3; clicked => { root.tab = 3; } }
    Rectangle { horizontal-stretch: 1; }
}

// A aba Detalhes (spec AF, seção 4): `kind` 0 = o álbum, 1 = uma foto, 3 = vários quadros (o
// texto mostra a aba Quadro, no painel).
export component InfoPanel inherits ScrollView {
    in property <[DetailRow]> rows;
    in property <int> kind;
    in property <string> count;
    in property <string> album;
    in property <string> spread;
    in property <string> warnings;
    in property <string> frame;
    in property <bool> frame-warn;
    in property <string> photo;
    VerticalLayout {
        width: root.visible-width;
        spacing: 8px;
        if root.kind == 1 && PhotoUi.has-photo: PhotoSection { }
        if root.kind == 3: Text { text: root.count; color: Theme.text; font-weight: Type.semibold; }
        for r in root.rows: VerticalLayout {
            spacing: 2px;
            Text { text: r.title; color: Theme.text-2; font-size: Type.small; }
            Text { text: r.value; color: Theme.text; wrap: word-wrap; }
        }
        if root.kind == 0: Text { text: "Lâmina"; color: Theme.text-2; font-size: Type.small; }
        if root.kind == 0: Text { text: root.spread; color: Theme.text; wrap: word-wrap; }
        Text { text: root.warnings; color: Theme.warning; wrap: word-wrap; }
        if root.kind == 1 && root.frame-warn: Text { text: root.frame; color: Theme.warning; wrap: word-wrap; }
        Rectangle { vertical-stretch: 1; }
    }
}

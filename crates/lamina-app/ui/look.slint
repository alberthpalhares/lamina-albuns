// Painel de aparência (spec AP): espaço entre fotos, fundo, borda e cantos. Só desenho: os
// valores e as edições vêm do editor.

import { Button, CheckBox, LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct Swatch {
    c: color,
    name: string,
}

component Stepper inherits HorizontalLayout {
    in property <string> value;
    callback step(int);
    spacing: 8px;
    Button { text: "−"; width: 34px; clicked => { root.step(-1); } }
    Text {
        text: root.value;
        color: Theme.text;
        vertical-alignment: center;
        horizontal-alignment: center;
        min-width: 70px;
    }
    Button { text: "+"; width: 34px; clicked => { root.step(1); } }
}

// 12 cores em duas linhas de 6.
export component Swatches inherits Rectangle {
    in property <[Swatch]> palette;
    in property <color> chosen;
    callback pick(int);
    height: 2 * 30px;
    for s[i] in root.palette: Rectangle {
        x: mod(i, 6) * 32px;
        y: floor(i / 6) * 30px;
        width: 26px;
        height: 26px;
        border-radius: 4px;
        background: s.c;
        border-width: s.c == root.chosen ? 2px : 1px;
        border-color: s.c == root.chosen ? Theme.selected : #ffffff30;
        TouchArea { clicked => { root.pick(i); } }
    }
}

component Label inherits Text {
    color: Theme.muted;
    font-size: 12px;
}

// O estado da aba fica num global, como o dos presets (`app.slint` estava grande demais).
export global LookUi {
    in property <[Swatch]> palette;
    in property <string> gap;
    in property <string> border;
    in property <string> radius;
    in property <bool> split;
    in property <color> left;
    in property <color> right;
    in property <color> border-color;
    in property <bool> only-frame;
    in-out property <string> hex;
    in property <string> hex-error;
    callback gap-step(int);
    callback border-step(int);
    callback radius-step(int);
    callback background(int, int);
    callback background-hex(string);
    callback split-changed(bool);
    callback border-pick(int);
    callback apply-all();
    // Lâmina à mão (spec TX, regra 8): o espaço entre fotos não mexe nos quadros dela.
    in property <bool> manual;
}

export component LookPanel inherits VerticalLayout {
    // Depois de um clique, o teclado volta para a lâmina.
    callback done();
    spacing: 8px;

    Label { text: "Espaço entre fotos"; }
    Stepper { value: LookUi.gap; step(d) => { LookUi.gap-step(d); root.done(); } }
    if LookUi.manual: Text {
        text: "Esta lâmina está à mão: o espaço entre fotos não muda os quadros dela.";
        color: Theme.muted;
        font-size: 12px;
        wrap: word-wrap;
    }

    HorizontalLayout {
        Label { text: "Fundo"; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        CheckBox {
            text: "Por página";
            checked: LookUi.split;
            toggled => { LookUi.split-changed(self.checked); root.done(); }
        }
    }
    if !LookUi.split: Swatches {
        palette: LookUi.palette;
        chosen: LookUi.left;
        pick(i) => { LookUi.background(i, -1); root.done(); }
    }
    if LookUi.split: Label { text: "Página esquerda"; }
    if LookUi.split: Swatches {
        palette: LookUi.palette;
        chosen: LookUi.left;
        pick(i) => { LookUi.background(i, 0); root.done(); }
    }
    if LookUi.split: Label { text: "Página direita"; }
    if LookUi.split: Swatches {
        palette: LookUi.palette;
        chosen: LookUi.right;
        pick(i) => { LookUi.background(i, 1); root.done(); }
    }
    HorizontalLayout {
        spacing: 6px;
        LineEdit {
            text <=> LookUi.hex;
            placeholder-text: "#F5F0E6";
            accepted(t) => { LookUi.background-hex(t); }
        }
        Button { text: "Usar"; clicked => { LookUi.background-hex(LookUi.hex); } }
    }
    if LookUi.hex-error != "": Text { text: LookUi.hex-error; color: Theme.warning; font-size: 12px; }

    Label { text: LookUi.only-frame ? "Borda (quadro selecionado)" : "Borda (todas as fotos da lâmina)"; }
    Stepper { value: LookUi.border; step(d) => { LookUi.border-step(d); root.done(); } }
    Swatches {
        palette: LookUi.palette;
        chosen: LookUi.border-color;
        pick(i) => { LookUi.border-pick(i); root.done(); }
    }

    Label { text: LookUi.only-frame ? "Cantos (quadro selecionado)" : "Cantos (todas as fotos da lâmina)"; }
    Stepper { value: LookUi.radius; step(d) => { LookUi.radius-step(d); root.done(); } }

    Rectangle { vertical-stretch: 1; }
    Button { text: "Aplicar a todas as lâminas"; clicked => { LookUi.apply-all(); root.done(); } }
}

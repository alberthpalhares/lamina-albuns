// Ajuda → Sobre o Lamina: o logo, a versão, a licença e o AboutSlint, a atribuição que a licença
// royalty-free do Slint pede numa tela Sobre (ADR 0002).

import { AboutSlint, Button } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Shade, Panel } from "widgets.slint";

export component AboutDialog inherits Shade {
    in property <string> version;
    callback close();
    Panel {
        width: 460px;
        height: 420px;
        VerticalLayout {
            padding: 28px;
            spacing: 14px;
            alignment: start;
            Image {
                source: @image-url("../icons/lamina-logo-escuro.svg");
                height: 52px;
                image-fit: contain;
                horizontal-alignment: left;
            }
            Text {
                text: "Versão " + root.version + "\nDiagramação de álbuns de fotos para impressão.\nCódigo aberto, licença Apache-2.0.";
                color: Theme.text;
                wrap: word-wrap;
            }
            AboutSlint { height: 120px; }
            HorizontalLayout {
                alignment: end;
                Button { text: "OK"; primary: true; clicked => { root.close(); } }
            }
        }
    }
}

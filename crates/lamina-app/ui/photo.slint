// A seção Foto (spec AF, seção 3; spec OP): o tamanho do quadro, endireitar, escala, brilho,
// contraste, preto e branco, opacidade, borda, cor da borda, cantos e restaurar. Só desenho: o
// editor decide e o Rust preenche o `PhotoUi`.

import { Button, CheckBox, LineEdit, Slider } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { LookUi, Stepper, Swatches } from "look.slint";

export global PhotoUi {
    in property <bool> has-photo;
    // O ângulo pede um quadro só (AF-B19).
    in property <bool> can-turn;
    in-out property <string> angle;
    in-out property <float> angle-value;
    in-out property <string> scale;
    in-out property <float> brightness;
    in-out property <float> contrast;
    in-out property <bool> bw;
    in property <string> error;
    // "Vale para esta foto em todos os quadros" (regra 1), quando a foto está em mais de um.
    in property <string> note;
    // O controle arrastado (em décimos de grau ou em pontos de −100 a 100).
    callback angle-moved(float);
    callback angle-accepted();
    callback angle-step(int);
    callback angle-zero();
    callback scale-accepted();
    callback brightness-moved(float);
    callback contrast-moved(float);
    // Soltou um controle: a próxima mudança é outra edição.
    callback released();
    callback bw-toggled(bool);
    callback restore();
    // Spec OP: "Quadro de 12,4 × 8,3 cm" (um quadro só), a opacidade em %, a borda e os cantos
    // ("1,5 mm") e a cor da borda; "Vale para os N quadros selecionados" com vários.
    in property <string> size;
    in-out property <float> opacity: 100;
    in property <string> border;
    in property <color> border-color;
    in property <string> radius;
    in property <string> style-note;
    callback opacity-moved(float);
    callback border-step(int);
    callback border-pick(int);
    callback radius-step(int);
}

component Label inherits Text {
    color: Theme.muted;
    font-size: 12px;
}

export component PhotoSection inherits VerticalLayout {
    spacing: 6px;
    Text { text: "Foto"; color: Theme.text; font-weight: 700; }
    if PhotoUi.size != "": Text { text: PhotoUi.size; color: Theme.muted; font-size: 12px; }
    if PhotoUi.note != "": Text { text: PhotoUi.note; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
    Label { text: PhotoUi.can-turn ? "Endireitar" : "Endireitar (selecione um quadro só)"; }
    Slider {
        enabled: PhotoUi.can-turn;
        minimum: -45;
        maximum: 45;
        value <=> PhotoUi.angle-value;
        changed(v) => { PhotoUi.angle-moved(v); }
        released => { PhotoUi.released(); }
    }
    HorizontalLayout {
        spacing: 4px;
        LineEdit {
            enabled: PhotoUi.can-turn;
            width: 70px;
            text <=> PhotoUi.angle;
            accepted => { PhotoUi.angle-accepted(); }
        }
        Button { text: "−0,1"; enabled: PhotoUi.can-turn; clicked => { PhotoUi.angle-step(-1); } }
        Button { text: "+0,1"; enabled: PhotoUi.can-turn; clicked => { PhotoUi.angle-step(1); } }
        Button { text: "0°"; enabled: PhotoUi.can-turn; clicked => { PhotoUi.angle-zero(); } }
    }
    HorizontalLayout {
        spacing: 6px;
        Label { text: "Escala (%)"; vertical-alignment: center; }
        LineEdit {
            enabled: PhotoUi.can-turn;
            width: 70px;
            text <=> PhotoUi.scale;
            accepted => { PhotoUi.scale-accepted(); }
        }
    }
    Label { text: "Brilho  " + round(PhotoUi.brightness); }
    Slider {
        minimum: -100;
        maximum: 100;
        value <=> PhotoUi.brightness;
        changed(v) => { PhotoUi.brightness-moved(v); }
        released => { PhotoUi.released(); }
    }
    Label { text: "Contraste  " + round(PhotoUi.contrast); }
    Slider {
        minimum: -100;
        maximum: 100;
        value <=> PhotoUi.contrast;
        changed(v) => { PhotoUi.contrast-moved(v); }
        released => { PhotoUi.released(); }
    }
    CheckBox {
        text: "Preto e branco";
        checked <=> PhotoUi.bw;
        toggled => { PhotoUi.bw-toggled(self.checked); }
    }
    if PhotoUi.style-note != "": Text { text: PhotoUi.style-note; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
    Label { text: "Opacidade  " + round(PhotoUi.opacity) + "%"; }
    Slider {
        minimum: 0;
        maximum: 100;
        value <=> PhotoUi.opacity;
        changed(v) => { PhotoUi.opacity-moved(v); }
        released => { PhotoUi.released(); }
    }
    Label { text: "Borda"; }
    Stepper { value: PhotoUi.border; step(d) => { PhotoUi.border-step(d); } }
    Swatches {
        palette: LookUi.palette;
        chosen: PhotoUi.border-color;
        pick(i) => { PhotoUi.border-pick(i); }
    }
    Label { text: "Cantos"; }
    Stepper { value: PhotoUi.radius; step(d) => { PhotoUi.radius-step(d); } }
    Button { text: "Restaurar a foto"; clicked => { PhotoUi.restore(); } }
    if PhotoUi.error != "": Text { text: PhotoUi.error; color: #e57373; wrap: word-wrap; }
}

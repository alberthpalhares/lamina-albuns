// A seção Foto (spec AF, seção 3; spec OP): o tamanho do quadro, endireitar, escala, brilho,
// contraste, preto e branco, opacidade, borda, cor da borda, cantos e restaurar; clique duplo no
// seletor de endireitar, brilho ou contraste volta ao neutro (AF, regra 14). Só desenho: o editor
// decide e o Rust preenche o `PhotoUi`.

import { LineEdit } from "std-widgets.slint";
import { NumberField } from "number_field.slint";
import { Theme, Fixed, Type } from "theme.slint";
import { LookUi, Stepper, Swatches } from "look.slint";
import { IconButton, NeutralSlider, DialogButton, CheckRow } from "widgets.slint";

export global PhotoUi {
    in property <bool> has-photo;
    // O ângulo pede um quadro só (AF-B19).
    in property <bool> can-turn;
    in-out property <string> angle;
    in-out property <float> angle-value;
    in-out property <string> scale;
    in-out property <float> brightness;
    in-out property <float> contrast;
    in-out property <bool> bw;
    in property <string> error;
    // "Vale para esta foto em todos os quadros" (regra 1), quando a foto está em mais de um.
    in property <string> note;
    // O controle arrastado (em décimos de grau ou em pontos de −100 a 100).
    callback angle-moved(float);
    callback angle-accepted();
    callback angle-step(int);
    callback angle-zero();
    callback scale-accepted();
    callback brightness-moved(float);
    callback contrast-moved(float);
    // Soltou um controle: a próxima mudança é outra edição.
    callback released();
    // Clique duplo no seletor: o controle volta ao neutro (AF, regra 14).
    callback angle-reset();
    callback brightness-reset();
    callback contrast-reset();
    callback bw-toggled(bool);
    callback restore();
    // Spec CD: a escala pelo controle (posição de 0 a 1, proporcional ao logaritmo), o clique
    // duplo que volta a 100% e os botões de girar 90° (-1 ↺, 1 ↻).
    in-out property <float> scale-position;
    callback scale-moved(float);
    callback scale-reset();
    callback quarter(int);
    // Spec TM: temperatura e matiz, de −100 a 100.
    in-out property <float> temperature;
    in-out property <float> tint;
    callback temperature-moved(float);
    callback tint-moved(float);
    callback temperature-reset();
    callback tint-reset();
    // Spec OP: "Quadro de 12,4 × 8,3 cm" (um quadro só), a opacidade em %, a borda e os cantos
    // ("1,5 mm") e a cor da borda; "Vale para os N quadros selecionados" com vários.
    in property <string> size;
    in-out property <float> opacity: 100;
    in property <string> border;
    in property <color> border-color;
    in property <string> radius;
    in property <string> style-note;
    callback opacity-moved(float);
    // Clique duplo no seletor da opacidade: volta a 100% (spec OP, OP-B15).
    callback opacity-reset();
    callback border-step(int);
    callback border-pick(int);
    callback radius-step(int);
}

component Label inherits Text {
    color: Theme.text-2;
    font-size: Type.small;
}

export component PhotoSection inherits VerticalLayout {
    spacing: 6px;
    Text { text: "Foto"; color: Theme.text; font-weight: Type.semibold; }
    if PhotoUi.size != "": Text { text: PhotoUi.size; color: Theme.text-2; font-size: Type.small; }
    if PhotoUi.note != "": Text { text: PhotoUi.note; color: Theme.text-2; font-size: Type.caption; wrap: word-wrap; }
    // O giro de −180° a 180° (spec CD, regra 2), com os botões de 90°.
    Label { text: PhotoUi.can-turn ? "Girar" : "Girar (selecione um quadro só)"; }
    NeutralSlider {
        enabled: PhotoUi.can-turn;
        minimum: -180;
        maximum: 180;
        value <=> PhotoUi.angle-value;
        changed(v) => { PhotoUi.angle-moved(v); }
        released => { PhotoUi.released(); }
        reset => { PhotoUi.angle-reset(); }
    }
    // Os passos do giro em ícones pequenos, numa linha só (spec CD, correção de 2026-10-28).
    HorizontalLayout {
        spacing: 2px;
        alignment: start;
        NumberField {
            step-accepts: true;
            minimum: -180;
            maximum: 180;
            enabled: PhotoUi.can-turn;
            width: 64px;
            text <=> PhotoUi.angle;
            accepted => { PhotoUi.angle-accepted(); }
        }
        Rectangle { width: 4px; }
        IconButton {
            width: 26px; height: 26px; icon-size: 18px; tip-side: -1;
            icon: @image-url("../icons/cd/girar-esquerda.svg"); tip: "Girar 90° para a esquerda";
            enabled: PhotoUi.can-turn; clicked => { PhotoUi.quarter(-1); }
        }
        IconButton {
            width: 26px; height: 26px; icon-size: 18px; tip-side: -1;
            icon: @image-url("../icons/cd/girar-direita.svg"); tip: "Girar 90° para a direita";
            enabled: PhotoUi.can-turn; clicked => { PhotoUi.quarter(1); }
        }
        IconButton {
            width: 26px; height: 26px; icon-size: 18px;
            icon: @image-url("../icons/cd/fino-esquerda.svg"); tip: "−0,1°";
            enabled: PhotoUi.can-turn; clicked => { PhotoUi.angle-step(-1); }
        }
        IconButton {
            width: 26px; height: 26px; icon-size: 18px;
            icon: @image-url("../icons/cd/fino-direita.svg"); tip: "+0,1°";
            enabled: PhotoUi.can-turn; clicked => { PhotoUi.angle-step(1); }
        }
        IconButton {
            width: 26px; height: 26px; icon-size: 18px; tip-side: 1;
            icon: @image-url("../icons/cd/zerar.svg"); tip: "Voltar a 0°";
            enabled: PhotoUi.can-turn; clicked => { PhotoUi.angle-zero(); }
        }
    }
    // A escala pelo controle (spec CD, regra 1): proporcional ao logaritmo, de 100% a 800%.
    HorizontalLayout {
        spacing: 6px;
        Label { text: "Escala (%)"; vertical-alignment: center; }
        NumberField {
            step-accepts: true;
            minimum: 100;
            maximum: 800;
            enabled: PhotoUi.can-turn;
            width: 70px;
            text <=> PhotoUi.scale;
            accepted => { PhotoUi.scale-accepted(); }
        }
    }
    NeutralSlider {
        enabled: PhotoUi.can-turn;
        minimum: 0;
        maximum: 1;
        neutral: 0;
        value <=> PhotoUi.scale-position;
        changed(v) => { PhotoUi.scale-moved(v); }
        released => { PhotoUi.released(); }
        reset => { PhotoUi.scale-reset(); }
    }
    Label { text: "Brilho  " + round(PhotoUi.brightness); }
    NeutralSlider {
        minimum: -100;
        maximum: 100;
        value <=> PhotoUi.brightness;
        changed(v) => { PhotoUi.brightness-moved(v); }
        released => { PhotoUi.released(); }
        reset => { PhotoUi.brightness-reset(); }
    }
    Label { text: "Contraste  " + round(PhotoUi.contrast); }
    NeutralSlider {
        minimum: -100;
        maximum: 100;
        value <=> PhotoUi.contrast;
        changed(v) => { PhotoUi.contrast-moved(v); }
        released => { PhotoUi.released(); }
        reset => { PhotoUi.contrast-reset(); }
    }
    // Temperatura e matiz (spec TM): o trilho mostra a cor para cada lado.
    Label { text: "Temperatura  " + round(PhotoUi.temperature); }
    NeutralSlider {
        minimum: -100;
        maximum: 100;
        gradient: true;
        track-from: Fixed.cold;
        track-to: Fixed.warm;
        value <=> PhotoUi.temperature;
        changed(v) => { PhotoUi.temperature-moved(v); }
        released => { PhotoUi.released(); }
        reset => { PhotoUi.temperature-reset(); }
    }
    Label { text: "Matiz  " + round(PhotoUi.tint); }
    NeutralSlider {
        minimum: -100;
        maximum: 100;
        gradient: true;
        track-from: Fixed.green;
        track-to: Fixed.magenta;
        value <=> PhotoUi.tint;
        changed(v) => { PhotoUi.tint-moved(v); }
        released => { PhotoUi.released(); }
        reset => { PhotoUi.tint-reset(); }
    }
    CheckRow {
        text: "Preto e branco";
        checked <=> PhotoUi.bw;
        toggled => { PhotoUi.bw-toggled(self.checked); }
    }
    if PhotoUi.style-note != "": Text { text: PhotoUi.style-note; color: Theme.text-2; font-size: Type.caption; wrap: word-wrap; }
    Label { text: "Opacidade  " + round(PhotoUi.opacity) + "%"; }
    NeutralSlider {
        minimum: 0;
        maximum: 100;
        neutral: 100;
        value <=> PhotoUi.opacity;
        changed(v) => { PhotoUi.opacity-moved(v); }
        released => { PhotoUi.released(); }
        reset => { PhotoUi.opacity-reset(); }
    }
    Label { text: "Borda"; }
    Stepper { value: PhotoUi.border; step(d) => { PhotoUi.border-step(d); } }
    Swatches {
        palette: LookUi.palette;
        chosen: PhotoUi.border-color;
        pick(i) => { PhotoUi.border-pick(i); }
    }
    Label { text: "Cantos"; }
    Stepper { value: PhotoUi.radius; step(d) => { PhotoUi.radius-step(d); } }
    DialogButton { text: "Restaurar a foto"; clicked => { PhotoUi.restore(); } }
    if PhotoUi.error != "": Text { text: PhotoUi.error; color: Theme.error; wrap: word-wrap; }
}

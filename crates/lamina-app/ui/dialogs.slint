// Janelas sobre a janela principal: pergunta antes de sair, erro e andamento. O novo álbum fica em
// `new_project.slint`.

import { Button, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Shade, Panel } from "widgets.slint";

export component ConfirmDialog inherits Shade {
    in property <string> name;
    callback answer(int);
    Panel {
        width: 440px;
        height: 170px;
        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            Text {
                text: "Salvar as alterações em \"" + root.name + "\"?";
                font-size: 16px;
                font-weight: 600;
                color: Theme.text;
                wrap: word-wrap;
            }
            Text { text: "Sem salvar, as alterações do álbum se perdem. Os arquivos já exportados continuam na pasta."; color: Theme.muted; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button { text: "Cancelar"; clicked => { root.answer(2); } }
                Button { text: "Não salvar"; clicked => { root.answer(1); } }
                Button { text: "Salvar"; primary: true; clicked => { root.answer(0); } }
            }
        }
    }
}

export component MessageDialog inherits Shade {
    // Erro: a frase (title), o que fazer (message) e o detalhe técnico, recolhido (spec EH).
    in property <string> title;
    in property <string> message;
    in property <string> details;
    // Pasta para o botão "Abrir a pasta" (resumo da exportação, spec EI); vazia = sem botão.
    in property <string> folder;
    property <bool> expanded;
    callback close();
    callback open-folder();
    callback send-problem();
    Panel {
        width: 560px;
        height: root.expanded ? 440px : 250px;
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Text { text: root.title; font-size: 16px; font-weight: 600; color: Theme.text; wrap: word-wrap; }
            Text { text: root.message; color: Theme.text; wrap: word-wrap; vertical-stretch: root.expanded ? 0 : 1; }
            if root.expanded: TextEdit { text: root.details; read-only: true; wrap: word-wrap; vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                if root.details != "": Button {
                    text: root.expanded ? "Esconder detalhes" : "Mostrar detalhes";
                    clicked => { root.expanded = !root.expanded; }
                }
                Rectangle { horizontal-stretch: 1; }
                if root.details != "": Button { text: "Enviar problema…"; clicked => { root.send-problem(); } }
                if root.folder != "": Button { text: "Abrir a pasta"; clicked => { root.open-folder(); } }
                Button { text: "OK"; primary: true; clicked => { root.close(); } }
            }
        }
    }
}

export component BusyOverlay inherits Shade {
    in property <string> text;
    Panel {
        width: 380px;
        height: 90px;
        Text {
            text: root.text;
            color: Theme.text;
            font-size: 15px;
        }
    }
}

// A cópia de segurança (spec CS, regra 4): o álbum que ficou sem salvar numa queda. A pergunta vem
// do Rust (`src/backup.rs`).
export global RecoverUi {
    in-out property <bool> show;
    in property <string> question;
    callback recover();
    callback discard();
}

export component RecoverDialog inherits Shade {
    Panel {
        width: 480px;
        height: 190px;
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Text { text: RecoverUi.question; font-size: 16px; font-weight: 600; color: Theme.text; wrap: word-wrap; }
            Text { text: "Recuperar abre o álbum como estava, ainda sem salvar. Descartar apaga a cópia; o arquivo do álbum fica como foi salvo pela última vez."; color: Theme.muted; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button { text: "Descartar"; clicked => { RecoverUi.discard(); } }
                Button { text: "Recuperar"; primary: true; clicked => { RecoverUi.recover(); } }
            }
        }
    }
}

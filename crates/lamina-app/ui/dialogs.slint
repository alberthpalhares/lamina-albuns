// Janelas sobre a janela principal: novo álbum, pergunta antes de sair, erro, sobre e andamento.

import { Button, LineEdit, CheckBox, ComboBox, SpinBox, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Shade, Panel, Field } from "widgets.slint";
import { SpecForm, PresetUi } from "spec.slint";

export component NewAlbumDialog inherits Shade {
    in property <string> folder;
    in-out property <string> name;
    in-out property <string> width-cm;
    in-out property <string> height-cm;
    in-out property <string> dpi;
    in-out property <string> bleed-mm;
    in-out property <string> safe-mm;
    in-out property <string> spine-mm;
    in-out property <bool> starts-single;
    in-out property <bool> ends-single;
    in-out property <int> spreads;
    in-out property <int> reuse;
    in property <int> photos;
    in property <string> suggestion;
    in property <string> error;
    callback changed();
    callback create();
    callback cancel();

    Panel {
        width: 600px;
        height: 680px;
        VerticalLayout {
            padding: 24px;
            spacing: 10px;
            Text {
                text: "Novo álbum";
                font-size: 20px;
                font-weight: 700;
                color: Theme.text;
            }
            Text {
                text: root.folder + " · " + root.photos + " fotos";
                color: Theme.muted;
                overflow: elide;
            }
            Field {
                label: "Nome";
                LineEdit { text <=> root.name; edited => { root.changed(); } }
            }
            SpecForm {
                presets: PresetUi.presets;
                preset <=> PresetUi.new-preset;
                width-cm <=> root.width-cm;
                height-cm <=> root.height-cm;
                dpi <=> root.dpi;
                bleed-mm <=> root.bleed-mm;
                safe-mm <=> root.safe-mm;
                spine-mm <=> root.spine-mm;
                starts-single <=> root.starts-single;
                ends-single <=> root.ends-single;
                min-pages <=> PresetUi.new-min;
                max-pages <=> PresetUi.new-max;
                changed => { root.changed(); }
                picked(i) => { PresetUi.picked(0, i); }
                save-preset => { PresetUi.save-as(0); }
            }
            Field {
                label: "Número de lâminas";
                SpinBox { value <=> root.spreads; minimum: 1; maximum: max(1, root.photos); edited => { root.changed(); } }
            }
            Text { text: root.suggestion; color: Theme.muted; }
            Field {
                label: "Reutilização de desenhos";
                ComboBox { model: ["Baixa", "Média", "Alta"]; current-index <=> root.reuse; }
            }
            Text { text: root.error; color: Theme.warning; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button { text: "Cancelar"; clicked => { root.cancel(); } }
                Button {
                    text: "Criar";
                    primary: true;
                    enabled: root.error == "";
                    clicked => { root.create(); }
                }
            }
        }
    }
}

export component ConfirmDialog inherits Shade {
    in property <string> name;
    callback answer(int);
    Panel {
        width: 440px;
        height: 170px;
        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            Text {
                text: "Salvar as alterações em \"" + root.name + "\"?";
                font-size: 16px;
                font-weight: 600;
                color: Theme.text;
                wrap: word-wrap;
            }
            Text { text: "Sem salvar, as alterações do álbum se perdem. Os arquivos já exportados continuam na pasta."; color: Theme.muted; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button { text: "Cancelar"; clicked => { root.answer(2); } }
                Button { text: "Não salvar"; clicked => { root.answer(1); } }
                Button { text: "Salvar"; primary: true; clicked => { root.answer(0); } }
            }
        }
    }
}

export component MessageDialog inherits Shade {
    // Erro: a frase (title), o que fazer (message) e o detalhe técnico, recolhido (spec EH).
    in property <string> title;
    in property <string> message;
    in property <string> details;
    // Pasta para o botão "Abrir a pasta" (resumo da exportação, spec EI); vazia = sem botão.
    in property <string> folder;
    property <bool> expanded;
    callback close();
    callback open-folder();
    callback send-problem();
    Panel {
        width: 560px;
        height: root.expanded ? 440px : 250px;
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Text { text: root.title; font-size: 16px; font-weight: 600; color: Theme.text; wrap: word-wrap; }
            Text { text: root.message; color: Theme.text; wrap: word-wrap; vertical-stretch: root.expanded ? 0 : 1; }
            if root.expanded: TextEdit { text: root.details; read-only: true; wrap: word-wrap; vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                if root.details != "": Button {
                    text: root.expanded ? "Esconder detalhes" : "Mostrar detalhes";
                    clicked => { root.expanded = !root.expanded; }
                }
                Rectangle { horizontal-stretch: 1; }
                if root.details != "": Button { text: "Enviar problema…"; clicked => { root.send-problem(); } }
                if root.folder != "": Button { text: "Abrir a pasta"; clicked => { root.open-folder(); } }
                Button { text: "OK"; primary: true; clicked => { root.close(); } }
            }
        }
    }
}

export component BusyOverlay inherits Shade {
    in property <string> text;
    Panel {
        width: 380px;
        height: 90px;
        Text {
            text: root.text;
            color: Theme.text;
            font-size: 15px;
        }
    }
}

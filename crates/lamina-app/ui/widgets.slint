// Peças pequenas usadas em mais de uma tela: o botão da barra, a aba de filtro, o fundo e o
// painel dos diálogos, a linha de campo com rótulo, o botão de ícone e o balão de dica.

import { Theme } from "theme.slint";

export component BarButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    // O botão principal da barra, com fundo (auditoria da Fase 4, achado 25).
    in property <bool> primary;
    // O mouse em cima, para quem põe um balão de dica no botão (Exportar, spec JE).
    out property <bool> hovered: touch.has-hover;
    callback clicked();
    width: label.preferred-width + 24px;
    border-radius: 4px;
    background: root.primary && root.enabled
        ? (touch.has-hover ? #3b8fd4 : #2f7fc1)
        : (touch.has-hover && root.enabled ? #ffffff1a : transparent);
    label := Text {
        text: root.text;
        color: root.primary && root.enabled ? #ffffff : (root.enabled ? Theme.text : #6b6b6b);
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component FilterTab inherits BarButton {
    in property <bool> active;
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: root.active ? Theme.selected : transparent;
    }
}

// Fundo escuro que bloqueia os cliques na janela de baixo.
export component Shade inherits Rectangle {
    background: #000000a0;
    TouchArea { }
}

export component Panel inherits Rectangle {
    background: Theme.panel;
    border-radius: 8px;
    drop-shadow-blur: 24px;
    drop-shadow-color: #000000a0;
}

export component Field inherits HorizontalLayout {
    in property <string> label;
    spacing: 8px;
    Text {
        text: root.label;
        width: 200px;
        color: Theme.text;
        vertical-alignment: center;
    }
    @children
}

// Balão de dica (specs JE e ZR): aparece depois de meio segundo com o mouse parado em cima do
// botão (`shown`) e some na hora em que ele sai. Quem usa posiciona o balão.
export component Tip inherits Rectangle {
    in property <string> text;
    in property <bool> shown;
    property <bool> ready;
    changed shown => {
        root.ready = false;
    }
    Timer {
        interval: 500ms;
        running: root.shown && !root.ready;
        triggered => { root.ready = true; }
    }
    visible: root.shown && root.ready;
    width: label.preferred-width + 16px;
    height: 24px;
    border-radius: 4px;
    background: #101010;
    drop-shadow-blur: 6px;
    drop-shadow-color: #00000080;
    label := Text {
        text: root.text;
        color: Theme.text;
        font-size: 12px;
        vertical-alignment: center;
    }
}

// Botão só de ícone (specs JE e ZR): marcado ou apagado (indisponível), com o nome no balão de
// dica, embaixo dele.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tip;
    in property <bool> checked;
    in property <bool> enabled: true;
    // Onde o balão fica, para não sair da janela: -1 começa no botão, 0 no meio, 1 termina nele.
    in property <int> tip-side;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 4px;
    background: root.checked ? #ffffff26 : (touch.has-hover && root.enabled ? #ffffff1a : transparent);
    Image {
        width: 20px;
        height: 20px;
        source: root.icon;
        colorize: root.enabled ? Theme.text : #6b6b6b;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    if root.tip != "": Tip {
        x: root.tip-side < 0 ? 0px : root.tip-side > 0 ? parent.width - self.width : (parent.width - self.width) / 2;
        y: parent.height + 4px;
        text: root.tip;
        shown: touch.has-hover;
    }
}

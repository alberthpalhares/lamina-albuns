// Peças pequenas usadas em mais de uma tela: o botão da barra, a aba de filtro, o fundo e o
// painel dos diálogos e a linha de campo com rótulo.

import { Theme } from "theme.slint";

export component BarButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    // O botão principal da barra, com fundo (auditoria da Fase 4, achado 25).
    in property <bool> primary;
    callback clicked();
    width: label.preferred-width + 24px;
    border-radius: 4px;
    background: root.primary && root.enabled
        ? (touch.has-hover ? #3b8fd4 : #2f7fc1)
        : (touch.has-hover && root.enabled ? #ffffff1a : transparent);
    label := Text {
        text: root.text;
        color: root.primary && root.enabled ? #ffffff : (root.enabled ? Theme.text : #6b6b6b);
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component FilterTab inherits BarButton {
    in property <bool> active;
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: root.active ? Theme.selected : transparent;
    }
}

// Fundo escuro que bloqueia os cliques na janela de baixo.
export component Shade inherits Rectangle {
    background: #000000a0;
    TouchArea { }
}

export component Panel inherits Rectangle {
    background: Theme.panel;
    border-radius: 8px;
    drop-shadow-blur: 24px;
    drop-shadow-color: #000000a0;
}

export component Field inherits HorizontalLayout {
    in property <string> label;
    spacing: 8px;
    Text {
        text: root.label;
        width: 200px;
        color: Theme.text;
        vertical-alignment: center;
    }
    @children
}

// Peças pequenas usadas em mais de uma tela: o botão da barra, a aba de filtro, o fundo e o
// painel dos diálogos, a linha de campo com rótulo, o botão de ícone e o balão de dica.

import { Theme } from "theme.slint";

export component BarButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    // O botão principal da barra, com fundo (auditoria da Fase 4, achado 25).
    in property <bool> primary;
    // O mouse em cima, para quem põe um balão de dica no botão (Exportar, spec JE).
    out property <bool> hovered: touch.has-hover;
    callback clicked();
    width: label.preferred-width + 24px;
    border-radius: 4px;
    background: root.primary && root.enabled
        ? (touch.has-hover ? #3b8fd4 : #2f7fc1)
        : (touch.has-hover && root.enabled ? #ffffff1a : transparent);
    label := Text {
        text: root.text;
        color: root.primary && root.enabled ? #ffffff : (root.enabled ? Theme.text : #6b6b6b);
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component FilterTab inherits BarButton {
    in property <bool> active;
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: root.active ? Theme.selected : transparent;
    }
}

// Fundo escuro que bloqueia os cliques na janela de baixo.
export component Shade inherits Rectangle {
    background: #000000a0;
    TouchArea { }
}

export component Panel inherits Rectangle {
    background: Theme.panel;
    border-radius: 8px;
    drop-shadow-blur: 24px;
    drop-shadow-color: #000000a0;
}

export component Field inherits HorizontalLayout {
    in property <string> label;
    spacing: 8px;
    Text {
        text: root.label;
        width: 200px;
        color: Theme.text;
        vertical-alignment: center;
    }
    @children
}

// Balão de dica (specs JE e ZR): aparece depois de meio segundo com o mouse parado em cima do
// botão (`shown`) e some na hora em que ele sai. Quem usa posiciona o balão.
export component Tip inherits Rectangle {
    in property <string> text;
    in property <bool> shown;
    property <bool> ready;
    changed shown => {
        root.ready = false;
    }
    Timer {
        interval: 500ms;
        running: root.shown && !root.ready;
        triggered => { root.ready = true; }
    }
    visible: root.shown && root.ready;
    width: label.preferred-width + 16px;
    height: 24px;
    border-radius: 4px;
    background: #101010;
    drop-shadow-blur: 6px;
    drop-shadow-color: #00000080;
    label := Text {
        text: root.text;
        color: Theme.text;
        font-size: 12px;
        vertical-alignment: center;
    }
}

// Botão só de ícone (specs JE e ZR): marcado ou apagado (indisponível), com o nome no balão de
// dica, embaixo dele.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tip;
    in property <bool> checked;
    in property <bool> enabled: true;
    // Onde o balão fica, para não sair da janela: -1 começa no botão, 0 no meio, 1 termina nele.
    in property <int> tip-side;
    // O desenho dentro do botão; os botões pequenos do giro usam 18 px (spec CD).
    in property <length> icon-size: 20px;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 4px;
    background: root.checked ? #ffffff26 : (touch.has-hover && root.enabled ? #ffffff1a : transparent);
    Image {
        accessible-role: none;
        width: root.icon-size;
        height: root.icon-size;
        source: root.icon;
        colorize: root.enabled ? Theme.text : #6b6b6b;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    if root.tip != "": Tip {
        x: root.tip-side < 0 ? 0px : root.tip-side > 0 ? parent.width - self.width : (parent.width - self.width) / 2;
        y: parent.height + 4px;
        text: root.tip;
        shown: touch.has-hover;
    }
}

// Controle deslizante com valor neutro (spec AF, regra 14): arrastar o seletor ou clicar no trilho
// muda o valor; clique duplo no seletor pede a volta ao neutro (`reset`), que marca o trilho.
// Serve a endireitar, brilho e contraste, e à opacidade da OP (neutro 100).
export component NeutralSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> neutral: 0;
    in property <bool> enabled: true;
    // O trilho em degradê, de uma cor à outra (spec TM).
    in property <bool> gradient;
    in property <color> track-from;
    in property <color> track-to;
    in-out property <float> value;
    callback changed(float);
    callback released();
    callback reset();
    property <length> knob: 14px;
    property <length> span: max(1px, root.width - root.knob);
    property <float> range: max(0.000001, root.maximum - root.minimum);
    property <length> knob-x: root.span * clamp((root.value - root.minimum) / root.range, 0, 1);
    property <length> neutral-x: root.span * clamp((root.neutral - root.minimum) / root.range, 0, 1);
    property <float> start;
    property <bool> dragging;
    min-height: 24px;
    min-width: 60px;
    function on-knob(x: length) -> bool {
        return x >= root.knob-x - 2px && x <= root.knob-x + root.knob + 2px;
    }
    function value-at(x: length) -> float {
        return clamp(root.minimum + (x - root.knob / 2) / root.span * root.range, root.minimum, root.maximum);
    }
    function set(v: float) {
        if (v != root.value) {
            root.value = v;
            root.changed(v);
        }
    }
    Rectangle {
        x: root.knob / 2;
        y: (root.height - self.height) / 2;
        width: root.span;
        height: root.gradient ? 6px : 4px;
        border-radius: 2px;
        // Temperatura e matiz (spec TM): o trilho em degradê mostra para onde a cor vai.
        background: !root.enabled ? #3c3c3c
            : root.gradient ? @linear-gradient(90deg, root.track-from 0%, root.track-to 100%) : #5a5a5a;
    }
    // A marca do neutro no trilho.
    Rectangle {
        x: root.neutral-x + root.knob / 2 - 1px;
        y: (root.height - self.height) / 2;
        width: 2px;
        height: 10px;
        background: root.enabled ? Theme.muted : #5a5a5a;
    }
    Rectangle {
        x: root.knob-x;
        y: (root.height - self.height) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: root.enabled ? (touch.pressed || touch.has-hover ? #ffffff : Theme.selected) : #6b6b6b;
    }
    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(e) => {
            if (e.button != PointerEventButton.left) {
                return;
            }
            if (e.kind == PointerEventKind.down) {
                root.dragging = false;
                if (!root.on-knob(self.mouse-x)) {
                    root.set(root.value-at(self.mouse-x));
                }
                root.start = root.value;
            } else if (e.kind == PointerEventKind.up) {
                root.released();
            }
        }
        // Só arrasta depois de 3 px, para o clique duplo parado não mexer no valor.
        moved => {
            if (!self.pressed) {
                return;
            }
            if (!root.dragging && abs(self.mouse-x - self.pressed-x) < 3px) {
                return;
            }
            root.dragging = true;
            root.set(clamp(root.start + (self.mouse-x - self.pressed-x) / root.span * root.range, root.minimum, root.maximum));
        }
        double-clicked => {
            if (root.on-knob(self.pressed-x)) {
                root.reset();
            }
        }
    }
}
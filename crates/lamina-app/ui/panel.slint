// O painel da direita da janela: as abas Detalhes, Aparência, Quadro e Histórico (os layouts ficam
// na faixa de layouts, spec FL). Só desenho: os dados chegam da janela principal, e cada clique
// devolve o teclado à lâmina.

import { Theme } from "theme.slint";
import { LookPanel } from "look.slint";
import { FramePanel } from "frame.slint";
import { HistoryPanel, HistoryItem } from "history.slint";
import { PanelTabs, InfoPanel, DetailRow } from "side.slint";
import { OrganizeUi, OrganizePanel } from "organize.slint";

export component RightPanel inherits Rectangle {
    in-out property <int> tab;
    in property <[HistoryItem]> history;
    in property <int> history-pos;
    in property <string> info-album;
    in property <string> info-spread;
    in property <string> info-warnings;
    in property <string> info-frame;
    in property <bool> info-frame-warn;
    in property <string> info-photo;
    // A aba Detalhes (spec AF): as linhas e o tipo da seleção (0 álbum, 1 foto, 2 texto, 3 vários).
    in property <[DetailRow]> details;
    in property <int> details-kind;
    in property <string> details-count;
    callback history-go(int);
    callback done();
    width: 300px;
    background: Theme.panel;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        // No modo organizar, o painel do modo no lugar das abas (spec EG, EG-B23).
        if OrganizeUi.on: OrganizePanel {
            vertical-stretch: 1;
            done => { root.done(); }
        }
        if !OrganizeUi.on: PanelTabs { tab <=> root.tab; }
        if !OrganizeUi.on && root.tab == 2: LookPanel {
            vertical-stretch: 1;
            done => { root.done(); }
        }
        if !OrganizeUi.on && (root.tab == 4 || (root.tab == 1 && root.details-kind == 2)): FramePanel {
            vertical-stretch: 1;
            done => { root.done(); }
        }
        if !OrganizeUi.on && root.tab == 3: HistoryPanel {
            vertical-stretch: 1;
            items: root.history;
            position: root.history-pos;
            go(i) => { root.history-go(i); root.done(); }
        }
        if !OrganizeUi.on && root.tab == 1 && root.details-kind != 2: InfoPanel {
            vertical-stretch: 1;
            rows: root.details;
            kind: root.details-kind;
            count: root.details-count;
            album: root.info-album;
            spread: root.info-spread;
            warnings: root.info-warnings;
            frame: root.info-frame;
            frame-warn: root.info-frame-warn;
            photo: root.info-photo;
        }
    }
}
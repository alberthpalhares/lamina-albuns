// Modelos do fotógrafo (spec MD): o nome ao salvar a lâmina como modelo e a lista "Meus modelos"
// (renomear, apagar). Só desenho: as decisões são do editor.

import { Button, LineEdit, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Shade, Panel } from "widgets.slint";

export global ModelUi {
    in-out property <bool> show-name;
    in-out property <string> name;
    in property <string> name-message;
    in-out property <bool> show-list;
    in property <[string]> models;
    in-out property <int> list-selected: -1;
    in-out property <string> list-name;
    in property <string> list-message;
    callback name-save();
    callback list-rename();
    callback list-delete();
    callback closed();
}

// Lâmina → Salvar como modelo…
export component ModelNameDialog inherits Shade {
    Panel {
        width: 440px;
        height: 220px;
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Text { text: "Salvar como modelo"; font-size: 16px; font-weight: 600; color: Theme.text; }
            LineEdit {
                text <=> ModelUi.name;
                placeholder-text: "ex.: Abertura com título";
                accepted => { ModelUi.name-save(); }
            }
            Text { text: ModelUi.name-message; color: Theme.warning; wrap: word-wrap; vertical-stretch: 1; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button { text: "Cancelar"; clicked => { ModelUi.show-name = false; ModelUi.closed(); } }
                Button { text: "Salvar"; primary: true; clicked => { ModelUi.name-save(); } }
            }
        }
    }
}

// Lâmina → Meus modelos…
export component ModelsDialog inherits Shade {
    Panel {
        width: 480px;
        height: 420px;
        VerticalLayout {
            padding: 24px;
            spacing: 10px;
            Text { text: "Meus modelos"; font-size: 16px; font-weight: 600; color: Theme.text; }
            Text {
                text: ModelUi.models.length == 0
                    ? "Nenhum modelo salvo. Monte uma lâmina e use Lâmina → Salvar como modelo…"
                    : "Os modelos aparecem no painel de layouts quando as fotos casam com eles.";
                color: Theme.muted;
                wrap: word-wrap;
            }
            ListView {
                vertical-stretch: 1;
                for item[i] in ModelUi.models: Rectangle {
                    height: 28px;
                    border-radius: 4px;
                    background: i == ModelUi.list-selected ? #ffffff1f : touch.has-hover ? #ffffff0d : transparent;
                    Text { x: 8px; text: item; color: Theme.text; vertical-alignment: center; }
                    touch := TouchArea {
                        clicked => {
                            ModelUi.list-selected = i;
                            ModelUi.list-name = item;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                LineEdit { text <=> ModelUi.list-name; enabled: ModelUi.list-selected >= 0; }
                Button { text: "Renomear"; enabled: ModelUi.list-selected >= 0; clicked => { ModelUi.list-rename(); } }
                Button { text: "Apagar"; enabled: ModelUi.list-selected >= 0; clicked => { ModelUi.list-delete(); } }
            }
            Text { text: ModelUi.list-message; color: Theme.warning; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end;
                Button { text: "Fechar"; primary: true; clicked => { ModelUi.show-list = false; ModelUi.closed(); } }
            }
        }
    }
}
